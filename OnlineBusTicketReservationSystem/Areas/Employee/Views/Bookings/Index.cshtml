@model IEnumerable<OnlineBusTicketReservationSystem.Models.Booking>
@{
    ViewData["Title"] = "All Bookings";
    string? currentStatus = ViewBag.Status as string;
    string? currentSearch = ViewBag.Search as string;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="fa fa-ticket-alt me-2 text-primary"></i>All Bookings
        </h4>
        <p class="text-muted mb-0">Manage and view all customer bookings</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>New Booking
    </a>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5">@ViewBag.TotalCount</div>
            <small class="text-muted">Total</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-warning">@ViewBag.PendingCount</div>
            <small class="text-muted">Pending</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-success">@ViewBag.ConfirmedCount</div>
            <small class="text-muted">Confirmed</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-danger">@ViewBag.CancelledCount</div>
            <small class="text-muted">Cancelled</small>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card mb-3 border-0 shadow-sm">
    <div class="card-body py-2">
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap align-items-center">
            <input name="search" value="@currentSearch" class="form-control form-control-sm"
                   style="max-width:220px" placeholder="Search name/phone..." />
            <select name="status" class="form-select form-select-sm" style="max-width:160px">
                <option value="">All Status</option>
                @if (currentStatus == "Pending")
                {
                    <option value="Pending" selected>Pending</option>
                }
                else
                {
                    <option value="Pending">Pending</option>
                }
                @if (currentStatus == "Confirmed")
                {
                    <option value="Confirmed" selected>Confirmed</option>
                }
                else
                {
                    <option value="Confirmed">Confirmed</option>
                }
                @if (currentStatus == "Cancelled")
                {
                    <option value="Cancelled" selected>Cancelled</option>
                }
                else
                {
                    <option value="Cancelled">Cancelled</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="fa fa-search me-1"></i>Filter
            </button>
            @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentStatus))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background:linear-gradient(135deg,#0f3460,#e94560);color:white;">
                    <tr>
                        <th>#ID</th>
                        <th>Customer</th>
                        <th>Route</th>
                        <th>Bus</th>
                        <th>Departure</th>
                        <th>Pax</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        string badgeClass = b.BookingStatus == "Confirmed" ? "bg-success"
                            : b.BookingStatus == "Cancelled" ? "bg-danger" : "bg-warning text-dark";
                        <tr>
                            <td><span class="badge bg-secondary">#@b.BookingId.ToString("D4")</span></td>
                            <td>
                                <strong>@b.CustomerName</strong><br />
                                <small class="text-muted">@b.CustomerPhone</small>
                            </td>
                            <td>
                                <small>
                                    <i class="fa fa-map-marker-alt text-success me-1"></i>@b.Schedule?.Route?.SourceCity<br />
                                    <i class="fa fa-map-marker-alt text-danger me-1"></i>@b.Schedule?.Route?.DestinationCity
                                </small>
                            </td>
                            <td><small>@b.Schedule?.Bus?.BusNumber</small></td>
                            <td><small>@(b.Schedule?.DepartureTime.ToString("dd-MMM HH:mm"))</small></td>
                            <td><span class="badge bg-info">@(b.Passengers?.Count ?? 0)</span></td>
                            <td><strong>Rs.@b.TotalAmount.ToString("N0")</strong></td>
                            <td><span class="badge @badgeClass">@b.BookingStatus</span></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@b.BookingId"
                                       class="btn btn-sm btn-outline-info" title="Details">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a asp-action="PrintTicket" asp-route-id="@b.BookingId"
                                       class="btn btn-sm btn-outline-primary" title="Print">
                                        <i class="fa fa-print"></i>
                                    </a>
                                    @if (b.BookingStatus == "Confirmed")
                                    {
                                        <a asp-area="Employee" asp-controller="Cancellations"
                                           asp-action="Cancel" asp-route-bookingId="@b.BookingId"
                                           class="btn btn-sm btn-outline-danger" title="Cancel">
                                            <i class="fa fa-times"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fa fa-ticket-alt fa-3x mb-3 d-block opacity-25"></i>
                No bookings found.
            </div>
        }
    </div>
</div>
