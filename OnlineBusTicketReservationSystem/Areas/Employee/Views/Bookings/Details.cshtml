@model OnlineBusTicketReservationSystem.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <!-- Booking Info -->
        <div class="card mb-4">
            <div class="card-header text-white d-flex
                        justify-content-between align-items-center"
                 style="background:linear-gradient(135deg,#0f3460,#e94560)">
                <h5 class="mb-0">
                    <i class="fa fa-ticket-alt me-2"></i>
                    Booking #@Model.BookingId
                </h5>
                @if (Model.BookingStatus == "Confirmed")
                {
                    <span class="badge bg-success fs-6">Confirmed</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Cancelled</span>
                }
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="fw-semibold text-primary mb-3">
                            Customer Info
                        </h6>
                        <table class="table table-borderless table-sm">
                            <tr>
                                <th>Name</th>
                                <td>@Model.CustomerName</td>
                            </tr>
                            <tr>
                                <th>Phone</th>
                                <td>@Model.CustomerPhone</td>
                            </tr>
                            <tr>
                                <th>Booking Date</th>
                                <td>
                                    @(Model.BookingDate
                                    .ToString("dd-MMM-yyyy HH:mm"))
                                </td>
                            </tr>
                            <tr>
                                <th>Booked By</th>
                                <td>@Model.BookedByUser?.FullName</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-semibold text-primary mb-3">
                            Journey Info
                        </h6>
                        <table class="table table-borderless table-sm">
                            <tr>
                                <th>Route</th>
                                <td>
                                    @Model.Schedule?.Route?.SourceCity →
                                    @Model.Schedule?.Route?.DestinationCity
                                </td>
                            </tr>
                            <tr>
                                <th>Bus</th>
                                <td>
                                    @Model.Schedule?.Bus?.BusNumber
                                    (@Model.Schedule?.Bus?.BusType)
                                </td>
                            </tr>
                            <tr>
                                <th>Departure</th>
                                <td>
                                    @(Model.Schedule?.DepartureTime.ToString("dd-MMM-yyyy HH:mm"))
                                </td>
                            </tr>
                            <tr>
                                <th>Arrival</th>
                                <td>
                                    @(Model.Schedule?.ArrivalTime.ToString("dd-MMM-yyyy HH:mm"))
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Passengers -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0 fw-semibold">
                    <i class="fa fa-users me-2 text-primary"></i>
                    Passengers (@(Model.Passengers?.Count ?? 0))
                </h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Seat</th>
                            <th>Fare</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int pNum = 1;
                        }
                        @foreach (var p in Model.Passengers ?? new List<OnlineBusTicketReservationSystem.Models.Passenger>())
                        {
                            <tr>
                                <td>@pNum++</td>
                                <td>@p.FullName</td>
                                <td>@p.Age yrs</td>
                                <td>@(p.Gender ?? "-")</td>
                                <td>@(p.SeatNumber ?? "-")</td>
                                <td>
                                    <strong>
                                        Rs.@p.FareAmount.ToString("N2")
                                    </strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="5" class="text-end fw-bold">
                                Total:
                            </td>
                            <td>
                                <strong class="text-success fs-6">
                                    Rs.@Model.TotalAmount.ToString("N2")
                                </strong>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Payment -->
        @if (Model.Payment != null)
        {
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fa fa-money-bill me-2 text-success"></i>
                        Payment Info
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <strong>Amount Paid:</strong>
                            <span class="text-success ms-2">
                                Rs.@Model.Payment.AmountPaid.ToString("N2")
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Method:</strong>
                            <span class="ms-2">
                                @Model.Payment.PaymentMethod
                            </span>
                        </div>
                        <div class="col-md-4">
                            <strong>Status:</strong>
                            @if (Model.Payment.PaymentStatus == "Paid")
                            {
                                <span class="badge bg-success ms-2">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-warning ms-2 text-dark">
                                    @Model.Payment.PaymentStatus
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Actions -->
        <div class="d-flex gap-2">
            <a asp-action="PrintTicket"
               asp-route-id="@Model.BookingId"
               class="btn btn-primary">
                <i class="fa fa-print me-1"></i>Print Ticket
            </a>
            @if (Model.BookingStatus == "Confirmed")
            {
                <a asp-area="Employee"
                   asp-controller="Cancellations"
                   asp-action="Cancel"
                   asp-route-bookingId="@Model.BookingId"
                   class="btn btn-danger">
                    <i class="fa fa-times me-1"></i>Cancel Booking
                </a>
            }
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa fa-arrow-left me-1"></i>Back
            </a>
        </div>
    </div>
</div>