@model OnlineBusTicketReservationSystem.Models.ViewModels.EmployeeDashboardViewModel
@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="fa fa-tachometer-alt me-2 text-primary"></i>
            My Dashboard
        </h4>
        <p class="text-muted mb-0">
            @DateTime.Now.ToString("dddd, dd MMMM yyyy")
        </p>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#0f3460,#1a4a8a)">
            <div>
                <p class="mb-1 small opacity-75">My Bookings</p>
                <div class="stat-num">@Model.MyBookings</div>
                <small class="opacity-60">Total</small>
            </div>
            <i class="fa fa-ticket-alt stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#198754,#145c38)">
            <div>
                <p class="mb-1 small opacity-75">Today's Bookings</p>
                <div class="stat-num">@Model.TodayBookings</div>
                <small class="opacity-60">Today</small>
            </div>
            <i class="fa fa-calendar-day stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#e94560,#c0392b)">
            <div>
                <p class="mb-1 small opacity-75">Cancellations</p>
                <div class="stat-num">@Model.MyCancellations</div>
                <small class="opacity-60">Total</small>
            </div>
            <i class="fa fa-times-circle stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#fd7e14,#c96a00)">
            <div>
                <p class="mb-1 small opacity-75">My Revenue</p>
                <div class="stat-num" style="font-size:1.9rem">
                    Rs.@Model.MyRevenue.ToString("N0")
                </div>
                <small class="opacity-60">Collected</small>
            </div>
            <i class="fa fa-money-bill-wave stat-icon"></i>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card mb-4">
    <div class="card-body d-flex gap-2 flex-wrap p-3">
        <a asp-area="Employee"
           asp-controller="Dashboard"
           asp-action="Enquiry"
           class="btn btn-primary btn-sm">
            <i class="fa fa-search me-1"></i>Bus Enquiry
        </a>
        <a asp-area="Employee"
           asp-controller="Bookings"
           asp-action="Create"
           class="btn btn-success btn-sm">
            <i class="fa fa-plus me-1"></i>New Booking
        </a>
        <a asp-area="Employee"
           asp-controller="Bookings"
           asp-action="Index"
           class="btn btn-outline-primary btn-sm">
            <i class="fa fa-list me-1"></i>My Bookings
        </a>
        <a asp-area="Employee"
           asp-controller="Cancellations"
           asp-action="Index"
           class="btn btn-outline-danger btn-sm">
            <i class="fa fa-times-circle me-1"></i>Cancellations
        </a>
    </div>
</div>

<!-- Recent Bookings -->
<div class="card">
    <div class="card-header text-white"
         style="background:linear-gradient(135deg,#0f3460,#e94560)">
        <h6 class="mb-0">
            <i class="fa fa-history me-2"></i>My Recent Bookings
        </h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentBookings.Any())
        {
            <div class="text-center text-muted py-4">
                No bookings yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Customer</th>
                            <th>Route</th>
                            <th>Bus</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">
                                        #@b.BookingId
                                    </span>
                                </td>
                                <td>@b.CustomerName</td>
                                <td>
                                    <small>
                                        @b.Schedule?.Route?.SourceCity →
                                        @b.Schedule?.Route?.DestinationCity
                                    </small>
                                </td>
                                <td>
                                    <small>@b.Schedule?.Bus?.BusNumber</small>
                                </td>
                                <td>
                                    <small>
                                        @b.BookingDate.ToString("dd-MMM HH:mm")
                                    </small>
                                </td>
                                <td>
                                    <strong>
                                        Rs.@b.TotalAmount.ToString("N2")
                                    </strong>
                                </td>
                                <td>
                                    @if (b.BookingStatus == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            Confirmed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>