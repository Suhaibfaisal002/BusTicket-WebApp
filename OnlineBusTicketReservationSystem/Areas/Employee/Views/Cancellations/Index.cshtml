@model IEnumerable<OnlineBusTicketReservationSystem.Models.Cancellation>
@{
    ViewData["Title"] = "Cancellations";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">
        <i class="fa fa-times-circle me-2 text-danger"></i>
        My Cancellations
    </h4>
    <p class="text-muted mb-0">All cancelled bookings</p>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background:linear-gradient(135deg,#0f3460,#e94560);color:white;">
                    <tr>
                        <th>#Booking</th>
                        <th>Route</th>
                        <th>Cancelled On</th>
                        <th>Total Paid</th>
                        <th>Deduction %</th>
                        <th>Refund Amount</th>
                        <th>Refund Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary">
                                    #@c.BookingId
                                </span>
                            </td>
                            <td>
                                <small>
                                    @c.Booking?.Schedule?.Route?.SourceCity →
                                    @c.Booking?.Schedule?.Route?.DestinationCity
                                </small>
                            </td>
                            <td>
                                <small>
                                    @(c.CancellationDate.ToString("dd-MMM-yyyy HH:mm"))
                                </small>
                            </td>
                            <td>
                                Rs.@c.Booking?.TotalAmount.ToString("N2")
                            </td>
                            <td>
                                @if (c.DeductionPercent == 0)
                                {
                                    <span class="badge bg-success">
                                        Full Refund
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @c.DeductionPercent%
                                    </span>
                                }
                            </td>
                            <td>
                                <strong class="text-success">
                                    Rs.@c.RefundAmount.ToString("N2")
                                </strong>
                            </td>
                            <td>
                                @if (c.RefundStatus == "Processed")
                                {
                                    <span class="badge bg-success">
                                        Processed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details"
                                       asp-route-id="@c.CancellationId"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    @if (c.RefundStatus == "Pending")
                                    {
                                        <form asp-action="MarkRefunded"
                                              asp-route-id="@c.CancellationId"
                                              method="post" class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Mark Refunded">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fa fa-times-circle fa-3x mb-3 d-block opacity-25"></i>
                No cancellations found.
            </div>
        }
    </div>
</div>