@model OnlineBusTicketReservationSystem.Models.Cancellation

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Cancellation</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="BookingId" class="control-label"></label>
                <select asp-for="BookingId" class ="form-control" asp-items="ViewBag.BookingId"></select>
            </div>
            <div class="form-group">
                <label asp-for="CancellationDate" class="control-label"></label>
                <input asp-for="CancellationDate" class="form-control" />
                <span asp-validation-for="CancellationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DeductionPercent" class="control-label"></label>
                <input asp-for="DeductionPercent" class="form-control" />
                <span asp-validation-for="DeductionPercent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DeductedAmount" class="control-label"></label>
                <input asp-for="DeductedAmount" class="form-control" />
                <span asp-validation-for="DeductedAmount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RefundAmount" class="control-label"></label>
                <input asp-for="RefundAmount" class="form-control" />
                <span asp-validation-for="RefundAmount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RefundStatus" class="control-label"></label>
                <input asp-for="RefundStatus" class="form-control" />
                <span asp-validation-for="RefundStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
