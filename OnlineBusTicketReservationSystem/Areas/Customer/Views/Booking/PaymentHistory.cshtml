@model IEnumerable<OnlineBusTicketReservationSystem.Models.Booking>
@{
    ViewData["Title"] = "Payment History";
    decimal totalPaid     = ViewBag.TotalPaid     ?? 0m;
    decimal totalRefunded = ViewBag.TotalRefunded  ?? 0m;
    int totalBookings     = ViewBag.TotalBookings  ?? 0;
}

<section style="padding:3rem 0;background:var(--light);min-height:80vh">
    <div style="max-width:900px;margin:0 auto;padding:0 1.5rem">

        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem">
            <div>
                <h1 style="font-family:var(--font-head);font-size:2rem;color:var(--dark);margin:0">
                    💳 Payment History
                </h1>
                <p style="color:var(--muted);margin:0.25rem 0 0">All your transactions in one place</p>
            </div>
            <a asp-area="Customer" asp-controller="Booking" asp-action="MyBookings"
               style="color:var(--accent);font-size:0.88rem;font-weight:600;text-decoration:none">
                ← My Bookings
            </a>
        </div>

        <!-- Summary Cards -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:2rem">
            <div style="background:linear-gradient(135deg,#0f3460,#1d4ed8);border-radius:16px;padding:1.5rem;color:#fff">
                <div style="font-size:0.78rem;opacity:0.7;text-transform:uppercase;letter-spacing:1px">Total Transactions</div>
                <div style="font-size:2rem;font-weight:700;margin-top:0.3rem">@totalBookings</div>
            </div>
            <div style="background:linear-gradient(135deg,#16a34a,#15803d);border-radius:16px;padding:1.5rem;color:#fff">
                <div style="font-size:0.78rem;opacity:0.7;text-transform:uppercase;letter-spacing:1px">Total Paid</div>
                <div style="font-size:2rem;font-weight:700;margin-top:0.3rem">Rs. @totalPaid.ToString("N0")</div>
            </div>
            <div style="background:linear-gradient(135deg,#e94560,#b91c1c);border-radius:16px;padding:1.5rem;color:#fff">
                <div style="font-size:0.78rem;opacity:0.7;text-transform:uppercase;letter-spacing:1px">Total Refunded</div>
                <div style="font-size:2rem;font-weight:700;margin-top:0.3rem">Rs. @totalRefunded.ToString("N0")</div>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div style="text-align:center;padding:5rem 2rem;background:#fff;border-radius:20px;border:2px dashed var(--border)">
                <div style="font-size:3.5rem;margin-bottom:1rem">💳</div>
                <h3 style="color:var(--dark)">No payment records yet</h3>
                <p style="color:var(--muted)">Your payment history will appear here after your first booking.</p>
                <a asp-area="Customer" asp-controller="Booking" asp-action="Search"
                   style="background:var(--accent);color:#fff;padding:0.75rem 2rem;border-radius:50px;font-weight:700;text-decoration:none;display:inline-block;margin-top:1rem">
                    Book a Ticket
                </a>
            </div>
        }
        else
        {
            <div style="background:#fff;border-radius:16px;overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow)">
                <div style="padding:1rem 1.5rem;background:#f8fafc;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between">
                    <span style="font-weight:700;color:var(--dark);font-size:0.9rem">Transaction Records</span>
                    <span style="font-size:0.82rem;color:var(--muted)">@totalBookings record(s)</span>
                </div>

                <div style="overflow-x:auto">
                    <table style="width:100%;border-collapse:collapse;font-size:0.88rem">
                        <thead>
                            <tr style="background:#f1f5f9">
                                <th style="padding:0.8rem 1rem;text-align:left;color:var(--muted);font-weight:600;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px">Booking</th>
                                <th style="padding:0.8rem 1rem;text-align:left;color:var(--muted);font-weight:600;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px">Route</th>
                                <th style="padding:0.8rem 1rem;text-align:left;color:var(--muted);font-weight:600;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px">Date</th>
                                <th style="padding:0.8rem 1rem;text-align:left;color:var(--muted);font-weight:600;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px">Method</th>
                                <th style="padding:0.8rem 1rem;text-align:right;color:var(--muted);font-weight:600;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px">Amount</th>
                                <th style="padding:0.8rem 1rem;text-align:center;color:var(--muted);font-weight:600;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px">Status</th>
                                <th style="padding:0.8rem 1rem;text-align:center;color:var(--muted);font-weight:600;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px">Refund</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                string statusBg    = b.BookingStatus == "Confirmed" ? "#dcfce7" : b.BookingStatus == "Cancelled" ? "#fee2e2" : "#fef3c7";
                                string statusColor = b.BookingStatus == "Confirmed" ? "#16a34a" : b.BookingStatus == "Cancelled" ? "#b91c1c" : "#d97706";
                                <tr style="border-top:1px solid var(--border)">
                                    <td style="padding:0.9rem 1rem">
                                        <a asp-area="Customer" asp-controller="Booking"
                                           asp-action="Details" asp-route-id="@b.BookingId"
                                           style="color:var(--accent);font-weight:700;text-decoration:none">
                                            #@b.BookingId.ToString("D4")
                                        </a>
                                        <div style="font-size:0.75rem;color:var(--muted)">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                    </td>
                                    <td style="padding:0.9rem 1rem;color:var(--dark)">
                                        @b.Schedule?.Route?.SourceCity → @b.Schedule?.Route?.DestinationCity
                                    </td>
                                    <td style="padding:0.9rem 1rem;color:var(--muted)">
                                        @(b.Payment?.PaymentDate.ToString("dd MMM yyyy") ?? "-")
                                    </td>
                                    <td style="padding:0.9rem 1rem">
                                        <span style="background:#e0f2fe;color:#0369a1;padding:0.2rem 0.7rem;border-radius:99px;font-size:0.75rem;font-weight:600">
                                            💵 @(b.Payment?.PaymentMethod ?? "Cash")
                                        </span>
                                    </td>
                                    <td style="padding:0.9rem 1rem;text-align:right;font-weight:700;color:var(--dark)">
                                        Rs. @(b.Payment?.AmountPaid.ToString("N0") ?? b.TotalAmount.ToString("N0"))
                                    </td>
                                    <td style="padding:0.9rem 1rem;text-align:center">
                                        <span style="background:@statusBg;color:@statusColor;padding:0.2rem 0.8rem;border-radius:99px;font-size:0.75rem;font-weight:700">
                                            @b.BookingStatus
                                        </span>
                                    </td>
                                    <td style="padding:0.9rem 1rem;text-align:center">
                                        @if (b.Cancellation != null)
                                        {
                                            <div style="font-weight:700;color:#16a34a;font-size:0.88rem">
                                                Rs. @b.Cancellation.RefundAmount.ToString("N0")
                                            </div>
                                            <div style="font-size:0.72rem;color:var(--muted)">@b.Cancellation.RefundStatus</div>
                                        }
                                        else
                                        {
                                            <span style="color:var(--muted);font-size:0.82rem">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>
