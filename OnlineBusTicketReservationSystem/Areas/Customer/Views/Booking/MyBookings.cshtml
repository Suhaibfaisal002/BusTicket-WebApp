@model IEnumerable<OnlineBusTicketReservationSystem.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<section style="padding:3rem 0;background:var(--light);min-height:80vh">
    <div style="max-width:1000px;margin:0 auto;padding:0 1.5rem">

        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem">
            <div>
                <h1 style="font-family:var(--font-head);font-size:2rem;color:var(--dark)">My Bookings</h1>
                <p style="color:var(--muted)">All your ticket bookings in one place</p>
            </div>
            <a asp-area="Customer" asp-controller="Booking" asp-action="Search"
               style="background:var(--accent);color:#fff;padding:0.65rem 1.5rem;border-radius:50px;font-weight:700;font-size:0.88rem">
                + Book New Ticket
            </a>
        </div>

        @if (TempData["BookingConfirmedNotification"] != null)
        {
            <div style="background:#f0fdf4;border:1.5px solid #22c55e;border-radius:14px;padding:1rem 1.5rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:1rem">
                <span style="font-size:1.8rem">🎉</span>
                <div>
                    <div style="font-weight:700;color:#15803d;font-size:1rem">
                        Booking #@TempData["BookingConfirmedNotification"] has been confirmed by Admin!
                    </div>
                    <div style="color:#16a34a;font-size:0.85rem;margin-top:2px">
                        Your seat is reserved. You can now print your ticket.
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div style="text-align:center;padding:5rem 2rem;background:#fff;border-radius:20px;border:2px dashed var(--border)">
                <div style="font-size:3.5rem;margin-bottom:1rem">🎫</div>
                <h3 style="color:var(--dark);margin-bottom:0.5rem">No bookings yet!</h3>
                <p style="color:var(--muted);margin-bottom:2rem">Book your first ticket and start your journey.</p>
                <a asp-area="Customer" asp-controller="Booking" asp-action="Search"
                   style="background:var(--accent);color:#fff;padding:0.75rem 2rem;border-radius:50px;font-weight:700">
                    Search Buses
                </a>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:1rem">
                @foreach (var b in Model)
                {
                    string statusColor = b.BookingStatus == "Confirmed" ? "#16a34a"
                        : b.BookingStatus == "Cancelled" ? "#b91c1c" : "#d97706";
                    string statusBg = b.BookingStatus == "Confirmed" ? "#dcfce7"
                        : b.BookingStatus == "Cancelled" ? "#fee2e2" : "#fef3c7";
                    int paxCount = b.Passengers?.Count ?? 0;

                    <div style="background:#fff;border-radius:16px;padding:1.5rem;border:1px solid var(--border);box-shadow:var(--shadow)">
                        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem">

                            <div style="font-family:var(--font-head);font-size:1.3rem;color:var(--accent);min-width:70px">
                                #@b.BookingId.ToString("D4")
                            </div>

                            <div style="flex:1;min-width:200px">
                                <strong style="color:var(--dark);display:block;font-size:1rem">
                                    @b.Schedule?.Route?.SourceCity → @b.Schedule?.Route?.DestinationCity
                                </strong>
                                <span style="color:var(--muted);font-size:0.82rem">
                                    @(b.Schedule?.DepartureTime.ToString("dd MMM yyyy, HH:mm"))
                                    • @b.Schedule?.Bus?.BusType
                                    • @paxCount passenger(s)
                                </span>
                            </div>

                            <div style="text-align:center;flex-shrink:0">
                                <strong style="display:block;font-family:var(--font-head);font-size:1.2rem;color:var(--dark)">
                                    Rs. @b.TotalAmount.ToString("N0")
                                </strong>
                                <span style="font-size:0.75rem;color:var(--muted)">Total</span>
                            </div>

                            <span style="padding:0.3rem 0.9rem;border-radius:50px;font-size:0.75rem;font-weight:700;flex-shrink:0;background:@statusBg;color:@statusColor">
                                @b.BookingStatus
                            </span>

                            <div style="display:flex;gap:0.5rem;flex-shrink:0;flex-wrap:wrap">
                                <a asp-area="Customer" asp-controller="Booking"
                                   asp-action="Details" asp-route-id="@b.BookingId"
                                   style="background:var(--dark);color:#fff;padding:0.4rem 1rem;border-radius:8px;font-size:0.8rem;font-weight:600">
                                    Details
                                </a>
                                <a asp-area="Customer" asp-controller="Booking"
                                   asp-action="PrintTicket" asp-route-id="@b.BookingId"
                                   style="background:#1d4ed8;color:#fff;padding:0.4rem 1rem;border-radius:8px;font-size:0.8rem;font-weight:600">
                                    🖨️ Print
                                </a>
                                @if ((b.BookingStatus == "Confirmed" || b.BookingStatus == "Pending") &&
                                     b.Schedule?.DepartureTime > DateTime.Now)
                                {
                                    <a asp-area="Customer" asp-controller="Booking"
                                       asp-action="Cancel" asp-route-id="@b.BookingId"
                                       style="background:#fee2e2;color:#b91c1c;padding:0.4rem 1rem;border-radius:8px;font-size:0.8rem;font-weight:600;text-decoration:none">
                                        ✕ Cancel
                                    </a>
                                }
                                @if (b.BookingStatus == "Confirmed")
                                {
                                    bool hasReview = ViewBag.ReviewedBookingIds != null &&
                                        ((System.Collections.Generic.HashSet<int>)ViewBag.ReviewedBookingIds).Contains(b.BookingId);
                                    if (!hasReview)
                                    {
                                        <a asp-area="Customer" asp-controller="Booking"
                                           asp-action="LeaveReview" asp-route-bookingId="@b.BookingId"
                                           style="background:#fef3c7;color:#92400e;padding:0.4rem 1rem;border-radius:8px;font-size:0.8rem;font-weight:600;text-decoration:none">
                                            ⭐ Rate
                                        </a>
                                    }
                                    else
                                    {
                                        <span style="background:#f0fdf4;color:#16a34a;padding:0.4rem 1rem;border-radius:8px;font-size:0.8rem;font-weight:600">
                                            ✓ Reviewed
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
