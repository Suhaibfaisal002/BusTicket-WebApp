@model IEnumerable<OnlineBusTicketReservationSystem.Models.Schedule>
@{
    ViewData["Title"] = "Search Buses";

    // Pre-compute display date in top-level @{} block — avoids nested @{} inside @if
    DateTime parsedDate;
    string dateStr = ViewBag.TravelDate ?? "";
    string displayDate = DateTime.TryParse(dateStr, out parsedDate)
        ? parsedDate.ToString("dd MMM yyyy") : "";
}

<section class="c-inner-hero"
         style="background-image:url('https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=1400&q=80');min-height:auto;padding:4rem 1.5rem">
    <div class="c-hero-overlay"></div>
    <div class="c-hero-content">
        <span class="sec-badge white">Find Your Bus</span>
        <h1>Search <span class="text-accent">Buses</span></h1>

        <form asp-action="Search" asp-controller="Booking"
              asp-area="Customer" method="get" id="searchForm"
              style="max-width:900px;margin:1.5rem auto 0;background:rgba(255,255,255,0.08);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.15);border-radius:16px;padding:1.5rem;display:flex;flex-wrap:wrap;gap:1rem;align-items:flex-end">

            <div style="display:flex;flex-direction:column;gap:0.3rem;flex:1;min-width:150px">
                <label style="font-size:0.72rem;font-weight:700;color:rgba(255,255,255,0.6);letter-spacing:1px;text-transform:uppercase">📍 From</label>
                <select name="sourceCity"
                        style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);color:#fff;padding:0.65rem 1rem;border-radius:10px;font-size:0.9rem">
                    <option value="">Select City</option>
                    @foreach (var city in ViewBag.Cities ?? new List<string>())
                    {
                        <option value="@city"
                                selected="@(ViewBag.SourceCity == city ? "selected" : null)"
                                style="background:#1e293b">@city</option>
                    }
                </select>
            </div>

            <div style="display:flex;flex-direction:column;gap:0.3rem;flex:1;min-width:150px">
                <label style="font-size:0.72rem;font-weight:700;color:rgba(255,255,255,0.6);letter-spacing:1px;text-transform:uppercase">📍 To</label>
                <select name="destinationCity"
                        style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);color:#fff;padding:0.65rem 1rem;border-radius:10px;font-size:0.9rem">
                    <option value="">Select City</option>
                    @foreach (var city in ViewBag.Cities ?? new List<string>())
                    {
                        <option value="@city"
                                selected="@(ViewBag.DestinationCity == city ? "selected" : null)"
                                style="background:#1e293b">@city</option>
                    }
                </select>
            </div>

            <div style="display:flex;flex-direction:column;gap:0.3rem;min-width:160px">
                <label style="font-size:0.72rem;font-weight:700;color:rgba(255,255,255,0.6);letter-spacing:1px;text-transform:uppercase">📅 Date</label>
                <input type="date" name="travelDate"
                       value="@(ViewBag.TravelDate ?? DateTime.Today.ToString("yyyy-MM-dd"))"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);color:#fff;padding:0.65rem 1rem;border-radius:10px;font-size:0.9rem" />
            </div>

            <button type="submit"
                    style="background:var(--accent);color:#fff;padding:0.75rem 2rem;border-radius:12px;font-weight:700;font-size:0.95rem;border:none;cursor:pointer;white-space:nowrap">
                🔍 Search
            </button>
        </form>
    </div>
</section>

<section style="padding:3rem 0;background:var(--light);min-height:50vh">
    <div style="max-width:900px;margin:0 auto;padding:0 1.5rem">

        @{
            var history = ViewBag.SearchHistory as List<string> ?? new List<string>();
        }
        @if (history.Any() && string.IsNullOrEmpty(ViewBag.SourceCity as string))
        {
            <div style="background:#fff;border-radius:16px;padding:1.2rem 1.5rem;margin-bottom:1.5rem;border:1px solid var(--border);box-shadow:var(--shadow)">
                <div style="font-size:0.78rem;font-weight:700;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-bottom:0.8rem">
                    🕐 Recent Searches
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem">
                    @foreach (var item in history)
                    {
                        var parts = item.Split('➜');
                        if (parts.Length == 2)
                        {
                            <a href="?sourceCity=@Uri.EscapeDataString(parts[0])&destinationCity=@Uri.EscapeDataString(parts[1])"
                               style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.4rem 1rem;background:var(--light);border:1.5px solid var(--border);border-radius:50px;font-size:0.83rem;font-weight:600;color:var(--dark);text-decoration:none;transition:all 0.2s"
                               onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'"
                               onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--dark)'">
                                📍 @parts[0] → @parts[1]
                            </a>
                        }
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewBag.SourceCity as string))
        {
            <div style="margin-bottom:1.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
                <h2 style="font-family:var(--font-head);font-size:1.5rem;color:var(--dark)">
                    @ViewBag.SourceCity → @ViewBag.DestinationCity
                    <span style="font-size:1rem;font-weight:400;color:var(--muted)">on @displayDate</span>
                </h2>
                <span style="background:var(--dark);color:#fff;padding:0.3rem 1rem;border-radius:50px;font-size:0.82rem;font-weight:600">
                    @Model.Count() buses found
                </span>
            </div>
        }

        <div id="searchResults">
        @if (!Model.Any())
        {
            <div style="text-align:center;padding:4rem 2rem;background:#fff;border-radius:20px;border:2px dashed var(--border)">
                <div style="font-size:3.5rem;margin-bottom:1rem">🔍</div>
                <h3 style="color:var(--dark);margin-bottom:0.5rem">
                    @(string.IsNullOrEmpty(ViewBag.SourceCity as string)
                        ? "Search for buses above"
                        : "No buses found for this route")
                </h3>
                <p style="color:var(--muted);font-size:0.9rem">
                    @(string.IsNullOrEmpty(ViewBag.SourceCity as string)
                        ? "Select source city, destination and date to find available buses."
                        : "Try a different date or check back later.")
                </p>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:1rem">
                @foreach (var s in Model)
                {
                    int totalSeats    = s.Bus?.TotalSeats > 0 ? s.Bus.TotalSeats : 40;
                    int availSeats    = s.AvailableSeats;
                    int bookedSeats   = totalSeats - availSeats;
                    double filledPct  = (double)bookedSeats / totalSeats * 100;
                    string seatColor  = availSeats <= 3 ? "#ef4444" : availSeats <= 8 ? "#f59e0b" : "#16a34a";
                    string barColor   = availSeats <= 3 ? "#ef4444" : availSeats <= 8 ? "#f59e0b" : "#16a34a";
                    <div style="background:#fff;border-radius:16px;padding:1.5rem;border:2px solid var(--border);box-shadow:var(--shadow)"
                         onmouseover="this.style.borderColor='var(--accent)'"
                         onmouseout="this.style.borderColor='var(--border)'">
                        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem">

                            <div style="font-family:var(--font-head);font-size:2rem;color:var(--accent);min-width:80px">
                                @s.Bus?.BusCode
                            </div>

                            <div style="flex:1;min-width:200px">
                                <strong style="color:var(--dark);display:block;font-size:1rem">
                                    @s.Route?.SourceCity → @s.Route?.DestinationCity
                                </strong>
                                <span style="color:var(--muted);font-size:0.82rem">
                                    @s.Bus?.BusType • @s.Bus?.OperatorName
                                </span>
                            </div>

                            <div style="text-align:center;flex-shrink:0">
                                <strong style="display:block;font-size:1.2rem;color:var(--dark)">
                                    @(s.DepartureTime.ToString("HH:mm"))
                                </strong>
                                <span style="font-size:0.75rem;color:var(--muted)">Departure</span>
                            </div>

                            <div style="color:var(--muted)">→</div>

                            <div style="text-align:center;flex-shrink:0">
                                <strong style="display:block;font-size:1.2rem;color:var(--dark)">
                                    @(s.ArrivalTime.ToString("HH:mm"))
                                </strong>
                                <span style="font-size:0.75rem;color:var(--muted)">Arrival</span>
                            </div>

                            <div style="text-align:center;flex-shrink:0;min-width:90px">
                                <strong style="display:block;font-size:1rem;color:@seatColor">
                                    @availSeats/@totalSeats
                                </strong>
                                <span style="font-size:0.72rem;color:var(--muted)">Seats Left</span>
                                <div style="width:90px;height:6px;background:#e2e8f0;border-radius:99px;margin-top:5px;overflow:hidden">
                                    <div style="height:100%;width:@filledPct.ToString("F0")%;background:@barColor;border-radius:99px"></div>
                                </div>
                                @if (availSeats <= 3 && availSeats > 0)
                                {
                                    <span style="font-size:0.7rem;color:#ef4444;font-weight:800;display:block;margin-top:3px">🔥 Only @availSeats left!</span>
                                }
                                else if (availSeats == 0)
                                {
                                    <span style="font-size:0.7rem;color:#ef4444;font-weight:800;display:block;margin-top:3px">❌ Fully Booked</span>
                                }
                            </div>

                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
                            {
                                <a asp-area="Customer" asp-controller="Booking"
                                   asp-action="Book"
                                   asp-route-scheduleId="@s.ScheduleId"
                                   style="background:var(--accent);color:#fff;padding:0.6rem 1.5rem;border-radius:50px;font-weight:700;font-size:0.85rem;white-space:nowrap;flex-shrink:0">
                                    Book Now →
                                </a>
                            }
                            else
                            {
                                <a asp-area="Customer" asp-controller="Account"
                                   asp-action="Login"
                                   style="background:var(--dark);color:#fff;padding:0.6rem 1.5rem;border-radius:50px;font-weight:700;font-size:0.85rem;white-space:nowrap;flex-shrink:0">
                                    Login to Book
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        </div><!-- /searchResults -->
    </div>
</section>

@section Scripts {
<script>
// ✅ AJAX Search — form submit pe page reload nahi, results update honge
document.getElementById('searchForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const form     = this;
    const params   = new URLSearchParams(new FormData(form));
    const source   = params.get('sourceCity');
    const dest     = params.get('destinationCity');
    const date     = params.get('travelDate');
    const isAuth   = @(User.Identity?.IsAuthenticated == true && User.IsInRole("Customer") ? "true" : "false");

    if (!source || !dest) {
        alert('Please select source and destination city.');
        return;
    }

    const container = document.getElementById('searchResults');
    container.innerHTML = `
        <div style="text-align:center;padding:3rem;background:#fff;border-radius:20px;border:2px dashed var(--border)">
            <div style="font-size:2rem;margin-bottom:0.5rem">⏳</div>
            <p style="color:var(--muted)">Searching buses...</p>
        </div>`;

    // Update browser URL without reload
    const url = new URL(window.location.href);
    url.searchParams.set('sourceCity', source);
    url.searchParams.set('destinationCity', dest);
    if (date) url.searchParams.set('travelDate', date);
    window.history.pushState({}, '', url);

    fetch(`/Customer/Booking/SearchAjax?sourceCity=${encodeURIComponent(source)}&destinationCity=${encodeURIComponent(dest)}&travelDate=${encodeURIComponent(date || '')}`)
        .then(r => r.json())
        .then(data => {
            if (!data.success || data.count === 0) {
                container.innerHTML = `
                    <div style="text-align:center;padding:4rem 2rem;background:#fff;border-radius:20px;border:2px dashed var(--border)">
                        <div style="font-size:3.5rem;margin-bottom:1rem">🔍</div>
                        <h3 style="color:var(--dark);margin-bottom:0.5rem">No buses found for this route</h3>
                        <p style="color:var(--muted);font-size:0.9rem">Try a different date or check back later.</p>
                    </div>`;
                return;
            }

            let html = `<div style="margin-bottom:1rem;font-weight:700;color:var(--dark)">${data.count} bus${data.count > 1 ? 'es' : ''} found</div>`;
            html += `<div style="display:flex;flex-direction:column;gap:1rem">`;

            data.schedules.forEach(s => {
                const filled  = ((s.totalSeats - s.availSeats) / s.totalSeats * 100).toFixed(0);
                const color   = s.availSeats <= 3 ? '#ef4444' : s.availSeats <= 8 ? '#f59e0b' : '#16a34a';
                const bookBtn = isAuth
                    ? `<a href="/Customer/Booking/Book?scheduleId=${s.scheduleId}"
                          style="background:var(--accent);color:#fff;padding:0.6rem 1.5rem;border-radius:50px;font-weight:700;font-size:0.85rem;white-space:nowrap;flex-shrink:0;text-decoration:none">
                           Book Now →
                       </a>`
                    : `<a href="/Customer/Account/Login"
                          style="background:var(--dark);color:#fff;padding:0.6rem 1.5rem;border-radius:50px;font-weight:700;font-size:0.85rem;white-space:nowrap;flex-shrink:0;text-decoration:none">
                           Login to Book
                       </a>`;

                html += `
                <div style="background:#fff;border-radius:16px;padding:1.5rem;border:2px solid var(--border);box-shadow:var(--shadow)"
                     onmouseover="this.style.borderColor='var(--accent)'"
                     onmouseout="this.style.borderColor='var(--border)'">
                    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem">
                        <div style="font-family:var(--font-head);font-size:2rem;color:var(--accent);min-width:80px">${s.busCode ?? ''}</div>
                        <div style="flex:1;min-width:200px">
                            <strong style="color:var(--dark);display:block;font-size:1rem">${s.sourceCity} → ${s.destCity}</strong>
                            <span style="color:var(--muted);font-size:0.82rem">${s.busType} • ${s.operatorName ?? ''}</span>
                        </div>
                        <div style="text-align:center;flex-shrink:0">
                            <strong style="display:block;font-size:1.2rem;color:var(--dark)">${s.departure}</strong>
                            <span style="font-size:0.75rem;color:var(--muted)">Departure</span>
                        </div>
                        <div style="color:var(--muted)">→</div>
                        <div style="text-align:center;flex-shrink:0">
                            <strong style="display:block;font-size:1.2rem;color:var(--dark)">${s.arrival}</strong>
                            <span style="font-size:0.75rem;color:var(--muted)">Arrival</span>
                        </div>
                        <div style="text-align:center;flex-shrink:0;min-width:90px">
                            <strong style="display:block;font-size:1rem;color:${color}">${s.availSeats}/${s.totalSeats}</strong>
                            <span style="font-size:0.72rem;color:var(--muted)">Seats Left</span>
                            <div style="width:90px;height:6px;background:#e2e8f0;border-radius:99px;margin-top:5px;overflow:hidden">
                                <div style="height:100%;width:${filled}%;background:${color};border-radius:99px"></div>
                            </div>
                            ${s.availSeats <= 3 && s.availSeats > 0 ? `<span style="font-size:0.7rem;color:#ef4444;font-weight:800;display:block;margin-top:3px">🔥 Only ${s.availSeats} left!</span>` : ''}
                        </div>
                        ${bookBtn}
                    </div>
                </div>`;
            });
            html += `</div>`;
            container.innerHTML = html;
        })
        .catch(() => {
            container.innerHTML = `
                <div style="text-align:center;padding:3rem;background:#fff;border-radius:20px;border:2px solid #fca5a5">
                    <p style="color:#b91c1c">Something went wrong. Please try again.</p>
                </div>`;
        });
});
</script>
}
