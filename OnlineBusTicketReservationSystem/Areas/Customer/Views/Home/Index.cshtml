@{
    ViewData["Title"] = "Home";
}

<!-- ── HERO ── -->
<section style="position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;">
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(15,23,42,0.93) 0%,rgba(15,23,42,0.7) 50%,rgba(15,23,42,0.4) 100%);z-index:1"></div>
    <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=1600&q=80"
         alt="Bus Journey"
         style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0" />

    <div style="position:relative;z-index:2;max-width:1280px;margin:0 auto;padding:4rem 1.5rem;width:100%">
        <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);color:#fff;font-size:0.78rem;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;padding:0.45rem 1.2rem;border-radius:50px;margin-bottom:2rem;backdrop-filter:blur(10px)">
            🇵🇰 Pakistan's Trusted Bus Network
        </div>

        <h1 style="font-family:var(--font-head);font-size:clamp(3rem,7vw,5.5rem);color:#fff;line-height:1;letter-spacing:-1px;margin-bottom:1.5rem">
            Your Journey,<br />
            <span style="color:var(--accent)">Our Responsibility</span>
        </h1>
        <p style="color:#94a3b8;font-size:1.1rem;max-width:560px;margin-bottom:3rem;line-height:1.7">
            Book bus tickets instantly across Pakistan. Safe, comfortable, and affordable travel with SRC Travel Agencies.
        </p>

        <!-- Search Box -->
        <div style="background:rgba(255,255,255,0.07);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.12);border-radius:20px;padding:1.5rem;margin-bottom:2.5rem;display:flex;flex-wrap:wrap;gap:0.75rem;align-items:flex-end">
            <div style="display:flex;flex-direction:column;gap:0.3rem;flex:1;min-width:150px">
                <label style="font-size:0.72rem;font-weight:700;color:rgba(255,255,255,0.5);letter-spacing:1px;text-transform:uppercase">📍 From</label>
                <input type="text" id="s-from" placeholder="Source City"
                       style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);color:#fff;padding:0.65rem 1rem;border-radius:10px;font-size:0.9rem" />
            </div>
            <div style="display:flex;flex-direction:column;gap:0.3rem;flex:1;min-width:150px">
                <label style="font-size:0.72rem;font-weight:700;color:rgba(255,255,255,0.5);letter-spacing:1px;text-transform:uppercase">📍 To</label>
                <input type="text" id="s-to" placeholder="Destination City"
                       style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);color:#fff;padding:0.65rem 1rem;border-radius:10px;font-size:0.9rem" />
            </div>
            <div style="display:flex;flex-direction:column;gap:0.3rem;flex:1;min-width:140px">
                <label style="font-size:0.72rem;font-weight:700;color:rgba(255,255,255,0.5);letter-spacing:1px;text-transform:uppercase">📅 Date</label>
                <input type="date" id="s-date"
                       style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);color:#fff;padding:0.65rem 1rem;border-radius:10px;font-size:0.9rem" />
            </div>
            <button onclick="heroSearch()"
                    style="background:var(--accent);color:#fff;padding:0.75rem 2rem;border-radius:12px;font-weight:700;font-size:0.95rem;border:2px solid var(--accent);cursor:pointer;white-space:nowrap;transition:all 0.25s">
                🔍 Search Buses
            </button>
        </div>

        <!-- Stats -->
        <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap">
            <div style="text-align:center">
                <strong style="display:block;font-family:var(--font-head);font-size:1.8rem;color:#fff">@(ViewBag.ScheduleCount ?? 0)+</strong>
                <span style="font-size:0.78rem;color:var(--muted)">Active Schedules</span>
            </div>
            <div style="width:1px;height:40px;background:rgba(255,255,255,0.15)"></div>
            <div style="text-align:center">
                <strong style="display:block;font-family:var(--font-head);font-size:1.8rem;color:#fff">50+</strong>
                <span style="font-size:0.78rem;color:var(--muted)">Cities</span>
            </div>
            <div style="width:1px;height:40px;background:rgba(255,255,255,0.15)"></div>
            <div style="text-align:center">
                <strong style="display:block;font-family:var(--font-head);font-size:1.8rem;color:#fff">99%</strong>
                <span style="font-size:0.78rem;color:var(--muted)">On-Time Rate</span>
            </div>
            <div style="width:1px;height:40px;background:rgba(255,255,255,0.15)"></div>
            <div style="text-align:center">
                <strong style="display:block;font-family:var(--font-head);font-size:1.8rem;color:#fff">4</strong>
                <span style="font-size:0.78rem;color:var(--muted)">Bus Types</span>
            </div>
        </div>
    </div>
</section>

<!-- ── POPULAR ROUTES ── -->
<section style="padding:5rem 0">
    <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">
        <div style="text-align:center;margin-bottom:3rem">
            <span class="sec-badge">Popular Routes</span>
            <h2 class="sec-title">Top <span class="text-accent">Destinations</span></h2>
            <p class="sec-sub">Most booked routes across Pakistan</p>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.2rem">
            @if (ViewBag.Routes != null)
            {
                foreach (var route in ViewBag.Routes)
                {
                    <div onclick="searchRoute('@route.SourceCity','@route.DestinationCity')"
                         style="background:#fff;border-radius:16px;border:1px solid var(--border);box-shadow:var(--shadow);padding:1.5rem;cursor:pointer;transition:all 0.25s;display:flex;align-items:center;gap:1rem"
                         onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateX(4px)'"
                         onmouseout="this.style.borderColor='var(--border)';this.style.transform='translateX(0)'">
                        <span style="font-size:2rem">🗺️</span>
                        <div>
                            <strong style="color:var(--dark);display:block;font-size:0.95rem">
                                @route.SourceCity → @route.DestinationCity
                            </strong>
                            <span style="color:var(--muted);font-size:0.8rem">
                                @(route.DistanceKm != null ? $"{route.DistanceKm} km" : "Click to search")
                            </span>
                        </div>
                        <span style="margin-left:auto;color:var(--accent);font-size:1.2rem;font-weight:700">→</span>
                    </div>
                }
            }
            else
            {
                <div style="grid-column:1/-1;text-align:center;color:var(--muted);padding:3rem">
                    <i class="fa fa-route fa-3x mb-3 d-block opacity-25"></i>
                    No routes available yet.
                </div>
            }
        </div>
    </div>
</section>

<!-- ── BUS TYPES ── -->
<section style="padding:5rem 0;background:var(--dark)">
    <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">
        <div style="text-align:center;margin-bottom:3rem">
            <span class="sec-badge white">Our Fleet</span>
            <h2 class="sec-title" style="color:#fff">Choose Your <span class="text-accent">Comfort Level</span></h2>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:1.5rem">
            @foreach (var bus in new[] {
                        new { type="Express", icon="🚌", color="#fef3c7", tc="#92400e", desc="Fast intercity travel with minimal stops. Budget-friendly option.", price="Rs. 500", features=new[]{"Reclining Seats","AC Available","On-board Security"} },
                        new { type="Luxury", icon="⭐", color="#ede9fe", tc="#5b21b6", desc="Premium leather seats, personal screens and complimentary snacks.", price="Rs. 1,800", features=new[]{"Leather Seats","Personal TV","Snacks Included"} },
                        new { type="Volvo-NonAC", icon="🚍", color="#dcfce7", tc="#14532d", desc="Sturdy Volvo build with wide comfortable seats and legroom.", price="Rs. 1,200", features=new[]{"Volvo Chassis","Wide Seats","Smooth Ride"} },
                        new { type="Volvo-AC", icon="❄️", color="#fee2e2", tc="#7f1d1d", desc="Climate-controlled luxury with push-back seats.", price="Rs. 2,500", features=new[]{"Full AC","Push-back Seats","WiFi Available"} }
                        })
            {
                <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:20px;overflow:hidden;transition:all 0.25s"
                     onmouseover="this.style.background='rgba(255,255,255,0.07)';this.style.transform='translateY(-6px)'"
                     onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.transform='translateY(0)'">
                    <div style="padding:2rem 1.5rem 1.5rem">
                        <div style="display:flex;align-items:center;gap:0.8rem;margin-bottom:1rem">
                            <span style="font-size:2rem">@bus.icon</span>
                            <span style="background:@bus.color;color:@bus.tc;font-size:0.72rem;font-weight:800;letter-spacing:1.5px;padding:0.3rem 0.8rem;border-radius:50px">@bus.type.ToUpper()</span>
                        </div>
                        <h3 style="font-family:var(--font-head);font-size:1.2rem;color:#fff;margin-bottom:0.5rem">@bus.type Bus</h3>
                        <p style="color:#94a3b8;font-size:0.85rem;line-height:1.6;margin-bottom:1rem">@bus.desc</p>
                        <ul style="list-style:none;display:flex;flex-direction:column;gap:0.3rem;margin-bottom:1.2rem">
                            @foreach (var f in bus.features)
                            {
                                <li style="font-size:0.82rem;color:#64748b">✓ @f</li>
                            }
                        </ul>
                        <div style="display:flex;justify-content:space-between;align-items:center">
                            <span style="color:var(--muted);font-size:0.85rem">From <strong style="color:var(--accent);font-size:1rem">@bus.price</strong></span>
                            <a asp-area="Customer" asp-controller="Booking" asp-action="Search"
                               style="background:var(--accent);color:#fff;padding:0.45rem 1.2rem;border-radius:50px;font-weight:700;font-size:0.8rem;border:2px solid var(--accent)">
                                Book Now
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ── WHY CHOOSE US ── -->
<section style="padding:5rem 0">
    <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center">
            <div style="position:relative">
                <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=700&q=80"
                     alt="Road Journey"
                     style="border-radius:20px;width:100%;height:500px;object-fit:cover" />
                <div style="position:absolute;bottom:-1.5rem;right:-1.5rem;background:var(--accent);color:#fff;padding:1.5rem;border-radius:16px;text-align:center;box-shadow:var(--shadow-lg)">
                    <div style="font-family:var(--font-head);font-size:2.5rem;line-height:1">15+</div>
                    <div style="font-size:0.78rem;font-weight:600;opacity:0.9">Years of Excellence</div>
                </div>
            </div>
            <div>
                <span class="sec-badge">Why SRC Travel</span>
                <h2 class="sec-title">Travel With <span class="text-accent">Confidence</span></h2>
                <p style="color:#475569;line-height:1.8;margin-bottom:2rem">
                    SRC Travel Agencies has been Pakistan's trusted bus reservation platform for over 15 years. We partner only with verified, safety-certified operators.
                </p>
                <div style="display:flex;flex-direction:column;gap:1.2rem">
                    @foreach (var feat in new[] {
                                        new { icon="🛡️", title="100% Safe & Verified", desc="All operators are background-checked and safety-certified." },
                                        new { icon="⚡", title="Instant Booking", desc="Get your e-ticket in seconds. No queues, no hassle." },
                                        new { icon="💰", title="Best Price Guarantee", desc="Transparent pricing with age-based discounts. No hidden charges." },
                                        new { icon="📞", title="24/7 Support", desc="Our support team is available around the clock." }
                                        })
                    {
                        <div style="display:flex;gap:1rem;align-items:flex-start">
                            <div style="font-size:1.5rem;width:48px;height:48px;background:#fde8ea;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0">@feat.icon</div>
                            <div>
                                <h4 style="color:var(--dark);font-size:0.95rem;font-weight:700;margin-bottom:0.2rem">@feat.title</h4>
                                <p style="color:var(--muted);font-size:0.85rem">@feat.desc</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    // Set today as default date
    document.addEventListener('DOMContentLoaded', function () {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('s-date').value = today;
        document.getElementById('s-date').min = today;
    });

    function heroSearch() {
        const from = document.getElementById('s-from').value.trim();
        const to   = document.getElementById('s-to').value.trim();
        const date = document.getElementById('s-date').value;

        if (!from || !to) {
            alert('Please enter both From and To city.');
            return;
        }

        const url = '/Customer/Booking/Search'
            + '?sourceCity=' + encodeURIComponent(from)
            + '&destinationCity=' + encodeURIComponent(to)
            + (date ? '&travelDate=' + date : '');

        window.location.href = url;
    }

    function searchRoute(from, to) {
        const today = new Date().toISOString().split('T')[0];
        const url = '/Customer/Booking/Search'
            + '?sourceCity=' + encodeURIComponent(from)
            + '&destinationCity=' + encodeURIComponent(to)
            + '&travelDate=' + today;
        window.location.href = url;
    }

    // Enter key on search inputs
    ['s-from', 's-to', 's-date'].forEach(function(id) {
        document.getElementById(id)?.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') heroSearch();
        });
    });
</script>
}
