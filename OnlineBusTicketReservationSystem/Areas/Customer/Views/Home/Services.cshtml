@{
    ViewData["Title"] = "Our Services";
}

<section class="c-inner-hero"
         style="background-image:url('https://images.unsplash.com/photo-1570125909232-eb263c188f7e?w=1400&q=80')">
    <div class="c-hero-overlay"></div>
    <div class="c-hero-content">
        <span class="sec-badge white">What We Offer</span>
        <h1>Our <span class="text-accent">Services</span></h1>
        <p>Everything you need for a comfortable journey across Pakistan</p>
    </div>
</section>

<!-- Online Booking Steps -->
<section style="padding:5rem 0;background:var(--light)">
    <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">
        <div style="text-align:center;margin-bottom:3rem">
            <span class="sec-badge">Easy and Fast</span>
            <h2 class="sec-title">Online <span class="text-accent">Booking</span></h2>
            <p class="sec-sub">Book your ticket in just 4 simple steps</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.5rem">
            @{
                var steps = new[] {
                    new { num="01", icon="🔍", title="Search", desc="Enter source city, destination and date to find available buses." },
                    new { num="02", icon="🚌", title="Select Bus", desc="Choose from available buses based on type, timing and fare." },
                    new { num="03", icon="👥", title="Add Passengers", desc="Enter passenger details. Age-based fares calculated automatically." },
                    new { num="04", icon="✅", title="Confirm", desc="Review and confirm your booking. Get your e-ticket instantly." }
                };
            }
            @foreach (var step in steps)
            {
                <div style="background:#fff;border-radius:20px;padding:2rem;border:1px solid var(--border);box-shadow:var(--shadow);text-align:center;position:relative;overflow:hidden">
                    <div style="position:absolute;top:-10px;right:-10px;font-family:var(--font-head);font-size:5rem;color:var(--light);font-weight:900;line-height:1">@step.num</div>
                    <div style="position:relative">
                        <div style="font-size:2.5rem;margin-bottom:1rem">@step.icon</div>
                        <h3 style="font-family:var(--font-head);font-size:1.2rem;color:var(--dark);margin-bottom:0.5rem">@step.title</h3>
                        <p style="color:var(--muted);font-size:0.88rem;line-height:1.6">@step.desc</p>
                    </div>
                </div>
            }
        </div>
        <div style="text-align:center;margin-top:2.5rem">
            <a asp-area="Customer" asp-controller="Booking" asp-action="Search"
               style="background:var(--accent);color:#fff;padding:0.85rem 2.5rem;border-radius:50px;font-weight:700;font-size:1rem">
                Search Buses Now
            </a>
        </div>
    </div>
</section>

<!-- Fleet -->
<section style="padding:5rem 0;background:var(--dark)">
    <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">
        <div style="text-align:center;margin-bottom:3rem">
            <span class="sec-badge white">Our Fleet</span>
            <h2 class="sec-title" style="color:#fff">Choose Your <span class="text-accent">Comfort</span></h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:1.5rem">
            @{
                var busTypes = new[] {
                    new { icon="🚌", type="Express", price="From Rs. 500", bg="#fef3c7", tc="#92400e",
                          f1="Fast intercity travel", f2="Minimal stops", f3="Budget-friendly", f4="AC Available" },
                    new { icon="⭐", type="Luxury", price="From Rs. 1,800", bg="#ede9fe", tc="#5b21b6",
                          f1="Premium leather seats", f2="Personal screens", f3="Snacks included", f4="Extra legroom" },
                    new { icon="🚍", type="Volvo-NonAC", price="From Rs. 1,200", bg="#dcfce7", tc="#14532d",
                          f1="Volvo chassis", f2="Wide comfortable seats", f3="Smooth ride", f4="Reclining seats" },
                    new { icon="❄️", type="Volvo-AC", price="From Rs. 2,500", bg="#fee2e2", tc="#7f1d1d",
                          f1="Full climate control", f2="Push-back seats", f3="WiFi available", f4="Premium service" }
                };
            }
            @foreach (var bus in busTypes)
            {
                <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:1.8rem">
                    <div style="display:flex;align-items:center;gap:0.8rem;margin-bottom:1rem">
                        <span style="font-size:2rem">@bus.icon</span>
                        <span style="background:@bus.bg;color:@bus.tc;font-size:0.72rem;font-weight:800;padding:0.3rem 0.8rem;border-radius:50px;letter-spacing:1px">@bus.type.ToUpper()</span>
                    </div>
                    <ul style="list-style:none;display:flex;flex-direction:column;gap:0.4rem;margin-bottom:1.2rem">
                        <li style="font-size:0.85rem;color:#94a3b8">✓ @bus.f1</li>
                        <li style="font-size:0.85rem;color:#94a3b8">✓ @bus.f2</li>
                        <li style="font-size:0.85rem;color:#94a3b8">✓ @bus.f3</li>
                        <li style="font-size:0.85rem;color:#94a3b8">✓ @bus.f4</li>
                    </ul>
                    <div style="font-size:0.9rem;color:var(--accent);font-weight:700">@bus.price</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Age Discounts -->
<section style="padding:5rem 0">
    <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">
        <div style="text-align:center;margin-bottom:3rem">
            <span class="sec-badge">Special Rates</span>
            <h2 class="sec-title">Age-Based <span class="text-accent">Discounts</span></h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1.2rem">
            @{
                var fares = new[] {
                    new { group="Children", age="0 - 5 yrs", discount="FREE", icon="👶", bg="#dcfce7", tc="#15803d" },
                    new { group="Kids", age="6 - 12 yrs", discount="50% OFF", icon="🧒", bg="#dbeafe", tc="#1d4ed8" },
                    new { group="Adults", age="13 - 49 yrs", discount="Full Fare", icon="🧑", bg="#f1f5f9", tc="#334155" },
                    new { group="Seniors", age="50+ yrs", discount="30% OFF", icon="👴", bg="#fef3c7", tc="#b45309" }
                };
            }
            @foreach (var fare in fares)
            {
                <div style="background:@fare.bg;border-radius:16px;padding:1.8rem;text-align:center">
                    <div style="font-size:2.5rem;margin-bottom:0.8rem">@fare.icon</div>
                    <div style="font-weight:700;color:var(--dark);margin-bottom:0.2rem">@fare.group</div>
                    <div style="font-size:0.82rem;color:var(--muted);margin-bottom:0.8rem">@fare.age</div>
                    <div style="font-family:var(--font-head);font-size:1.5rem;color:@fare.tc">@fare.discount</div>
                </div>
            }
        </div>
    </div>
</section>
