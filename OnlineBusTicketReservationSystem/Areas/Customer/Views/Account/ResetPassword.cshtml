@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5"
     style="background:linear-gradient(135deg,#0f3460 0%,#16213e 60%,#e94560 100%)">
    <div class="card shadow-lg" style="width:100%;max-width:440px;border-radius:20px;overflow:hidden">
        <div class="text-center py-4 px-4"
             style="background:linear-gradient(135deg,#0f3460,#8b5cf6)">
            <div style="font-size:2.5rem">🔑</div>
            <h4 class="text-white fw-bold mb-1 mt-2">Reset Password</h4>
            <p class="text-white-50 small mb-0">Enter your new password below</p>
        </div>

        <div class="card-body p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div><i class="fa fa-exclamation-circle me-1"></i>@err.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post" asp-action="ResetPassword" asp-area="Customer" asp-controller="Account">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@ViewBag.Email" />
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fa fa-lock text-secondary"></i>
                        </span>
                        <input type="password" name="newPassword" id="newPass"
                               class="form-control border-start-0 ps-0"
                               placeholder="Min 6 characters" required />
                        <button type="button" class="btn btn-outline-secondary border-start-0"
                                onclick="togglePass('newPass','eyeNew')">
                            <i class="fa fa-eye" id="eyeNew"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fa fa-lock text-secondary"></i>
                        </span>
                        <input type="password" name="confirmPassword" id="confPass"
                               class="form-control border-start-0 ps-0"
                               placeholder="Repeat new password" required />
                        <button type="button" class="btn btn-outline-secondary border-start-0"
                                onclick="togglePass('confPass','eyeConf')">
                            <i class="fa fa-eye" id="eyeConf"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn w-100 text-white fw-bold py-2 mt-1"
                        style="background:linear-gradient(135deg,#0f3460,#8b5cf6);border:none;border-radius:10px">
                    <i class="fa fa-check-circle me-2"></i>Reset Password
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function togglePass(inputId, iconId) {
    const inp = document.getElementById(inputId);
    const ico = document.getElementById(iconId);
    if (inp.type === 'password') {
        inp.type = 'text';
        ico.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        inp.type = 'password';
        ico.classList.replace('fa-eye-slash', 'fa-eye');
    }
}
</script>
}
