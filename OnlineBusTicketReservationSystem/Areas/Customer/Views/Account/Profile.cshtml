@model OnlineBusTicketReservationSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<section style="padding:3rem 0;background:var(--light);min-height:80vh">
    <div style="max-width:1000px;margin:0 auto;padding:0 1.5rem">

        <div style="margin-bottom:2rem">
            <h2 style="font-family:var(--font-head);font-size:1.8rem;color:var(--dark)">My Profile</h2>
            <p style="color:var(--muted)">Manage your personal information and account settings</p>
        </div>

        <div style="display:grid;grid-template-columns:1fr 2fr;gap:1.5rem">

            <!-- Left — Stats Card -->
            <div>
                <div style="background:#fff;border-radius:20px;padding:2rem;border:1px solid var(--border);box-shadow:var(--shadow);text-align:center;margin-bottom:1rem">
                    <div style="width:80px;height:80px;background:linear-gradient(135deg,var(--accent),#ef4444);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2rem;color:#fff;margin:0 auto 1rem;font-weight:700">
                        @Model.FullName?.Substring(0, 1).ToUpper()
                    </div>
                    <h4 style="font-family:var(--font-head);color:var(--dark);margin-bottom:0.2rem">@Model.FullName</h4>
                    <p style="color:var(--muted);font-size:0.85rem;margin-bottom:1rem">@Model.Email</p>
                    <span style="background:#dcfce7;color:#16a34a;padding:0.3rem 1rem;border-radius:50px;font-size:0.78rem;font-weight:700">
                        ✅ Active Customer
                    </span>
                    <div style="margin-top:1rem;font-size:0.8rem;color:var(--muted)">
                        Member since @Model.CreatedAt.ToString("MMM yyyy")
                    </div>
                </div>

                <!-- Booking Stats -->
                <div style="background:#fff;border-radius:16px;padding:1.5rem;border:1px solid var(--border);box-shadow:var(--shadow)">
                    <h6 style="font-weight:700;color:var(--dark);margin-bottom:1rem">Booking Summary</h6>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.8rem">
                        <span style="color:var(--muted);font-size:0.88rem">Total Bookings</span>
                        <span style="font-weight:700">@ViewBag.TotalBookings</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.8rem">
                        <span style="color:var(--muted);font-size:0.88rem">Confirmed</span>
                        <span style="font-weight:700;color:#16a34a">@ViewBag.ConfirmedCount</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.8rem">
                        <span style="color:var(--muted);font-size:0.88rem">Pending</span>
                        <span style="font-weight:700;color:#d97706">@ViewBag.PendingCount</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.8rem">
                        <span style="color:var(--muted);font-size:0.88rem">Cancelled</span>
                        <span style="font-weight:700;color:#dc2626">@ViewBag.CancelledCount</span>
                    </div>
                    <div style="border-top:1px solid var(--border);padding-top:0.8rem;margin-top:0.5rem;display:flex;justify-content:space-between">
                        <span style="color:var(--muted);font-size:0.88rem">Total Spent</span>
                        <span style="font-weight:700;color:var(--accent)">Rs. @(((decimal)ViewBag.TotalSpent).ToString("N0"))</span>
                    </div>
                </div>

                <!-- Quick Links -->
                <div style="margin-top:1rem;display:flex;flex-direction:column;gap:0.5rem">
                    <a asp-area="Customer" asp-controller="Booking" asp-action="MyBookings"
                       style="background:#fff;border:1px solid var(--border);border-radius:12px;padding:0.8rem 1rem;display:flex;align-items:center;gap:0.8rem;color:var(--dark);text-decoration:none;font-size:0.88rem;font-weight:600">
                        🎫 My Bookings
                    </a>
                    <a asp-area="Customer" asp-controller="Booking" asp-action="Search"
                       style="background:var(--accent);border-radius:12px;padding:0.8rem 1rem;display:flex;align-items:center;gap:0.8rem;color:#fff;text-decoration:none;font-size:0.88rem;font-weight:600">
                        🔍 Book New Ticket
                    </a>
                </div>
            </div>

            <!-- Right — Edit Form + Change Password -->
            <div style="display:flex;flex-direction:column;gap:1.5rem">

                <!-- Edit Profile -->
                <div style="background:#fff;border-radius:20px;padding:2rem;border:1px solid var(--border);box-shadow:var(--shadow)">
                    <h5 style="font-family:var(--font-head);color:var(--dark);margin-bottom:1.5rem">
                        ✏️ Edit Profile
                    </h5>
                    <form method="post" asp-action="Profile">
                        @Html.AntiForgeryToken()
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem">
                            <div>
                                <label style="font-size:0.82rem;font-weight:700;color:var(--dark);display:block;margin-bottom:0.4rem">Full Name *</label>
                                <input name="fullName" value="@Model.FullName" required type="text"
                                       style="width:100%;padding:0.65rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-size:0.9rem;outline:none" />
                            </div>
                            <div>
                                <label style="font-size:0.82rem;font-weight:700;color:var(--dark);display:block;margin-bottom:0.4rem">Phone</label>
                                <input name="phone" value="@Model.PhoneNumber" type="tel"
                                       style="width:100%;padding:0.65rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-size:0.9rem;outline:none" />
                            </div>
                            <div>
                                <label style="font-size:0.82rem;font-weight:700;color:var(--dark);display:block;margin-bottom:0.4rem">Gender</label>
                                <select name="gender" style="width:100%;padding:0.65rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-size:0.9rem;outline:none">
                                    <option value="">-- Select --</option>
                                    @if (Model.Gender == "Male")
                                    {
                                        <option value="Male" selected>Male</option>
                                    }
                                    else
                                    {
                                        <option value="Male">Male</option>
                                    }
                                    @if (Model.Gender == "Female")
                                    {
                                        <option value="Female" selected>Female</option>
                                    }
                                    else
                                    {
                                        <option value="Female">Female</option>
                                    }
                                    @if (Model.Gender == "Other")
                                    {
                                        <option value="Other" selected>Other</option>
                                    }
                                    else
                                    {
                                        <option value="Other">Other</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label style="font-size:0.82rem;font-weight:700;color:var(--dark);display:block;margin-bottom:0.4rem">Age</label>
                                <input name="age" value="@Model.Age" type="number" min="1" max="120"
                                       style="width:100%;padding:0.65rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-size:0.9rem;outline:none" />
                            </div>
                        </div>
                        <div style="margin-bottom:1rem">
                            <label style="font-size:0.82rem;font-weight:700;color:var(--dark);display:block;margin-bottom:0.4rem">Email (cannot be changed)</label>
                            <input value="@Model.Email" type="email" disabled
                                   style="width:100%;padding:0.65rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-size:0.9rem;background:#f8fafc;color:var(--muted)" />
                        </div>
                        <button type="submit"
                                style="background:var(--accent);color:#fff;padding:0.75rem 2rem;border-radius:50px;border:none;font-weight:700;font-size:0.95rem;cursor:pointer">
                            Save Changes
                        </button>
                    </form>
                </div>

                <!-- Change Password -->
                <div style="background:#fff;border-radius:20px;padding:2rem;border:1px solid var(--border);box-shadow:var(--shadow)">
                    <h5 style="font-family:var(--font-head);color:var(--dark);margin-bottom:1.5rem">
                        🔒 Change Password
                    </h5>
                    <form method="post" asp-action="ChangePassword">
                        @Html.AntiForgeryToken()
                        <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:1rem">
                            <div>
                                <label style="font-size:0.82rem;font-weight:700;color:var(--dark);display:block;margin-bottom:0.4rem">Current Password</label>
                                <input name="currentPassword" type="password" required
                                       style="width:100%;padding:0.65rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-size:0.9rem;outline:none" />
                            </div>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
                                <div>
                                    <label style="font-size:0.82rem;font-weight:700;color:var(--dark);display:block;margin-bottom:0.4rem">New Password</label>
                                    <input name="newPassword" type="password" required
                                           style="width:100%;padding:0.65rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-size:0.9rem;outline:none" />
                                </div>
                                <div>
                                    <label style="font-size:0.82rem;font-weight:700;color:var(--dark);display:block;margin-bottom:0.4rem">Confirm Password</label>
                                    <input name="confirmPassword" type="password" required
                                           style="width:100%;padding:0.65rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-size:0.9rem;outline:none" />
                                </div>
                            </div>
                        </div>
                        <button type="submit"
                                style="background:var(--dark);color:#fff;padding:0.75rem 2rem;border-radius:50px;border:none;font-weight:700;font-size:0.95rem;cursor:pointer">
                            Update Password
                        </button>
                    </form>
                </div>

                <!-- ✅ 2FA Toggle -->
                <div style="background:#fff;border-radius:20px;padding:2rem;border:1px solid var(--border);box-shadow:var(--shadow)">
                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
                        <div>
                            <h5 style="font-family:var(--font-head);color:var(--dark);margin-bottom:0.3rem">
                                🛡️ Two-Factor Authentication
                            </h5>
                            <p style="color:var(--muted);font-size:0.85rem;margin:0">
                                @if (Model.TwoFactorEmailEnabled)
                                {
                                    <span style="color:#16a34a;font-weight:600">✅ Enabled — OTP sent to your email on every login</span>
                                }
                                else
                                {
                                    <span>Disabled — Enable for extra account security</span>
                                }
                            </p>
                        </div>
                        <form method="post" asp-action="Toggle2FA" asp-controller="Account" asp-area="Customer">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    style="padding:0.6rem 1.5rem;border-radius:50px;border:none;font-weight:700;font-size:0.88rem;cursor:pointer;
                                           background:@(Model.TwoFactorEmailEnabled ? "#fee2e2" : "#dcfce7");
                                           color:@(Model.TwoFactorEmailEnabled ? "#b91c1c" : "#15803d")">
                                @(Model.TwoFactorEmailEnabled ? "Disable 2FA" : "Enable 2FA")
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
