@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5"
     style="background:linear-gradient(135deg,#0f3460 0%,#16213e 60%,#e94560 100%)">
    <div class="card shadow-lg" style="width:100%;max-width:440px;border-radius:20px;overflow:hidden">
        <div class="text-center py-4 px-4"
             style="background:linear-gradient(135deg,#0f3460,#e94560)">
            <div style="font-size:2.5rem">🔐</div>
            <h4 class="text-white fw-bold mb-1 mt-2">Forgot Password?</h4>
            <p class="text-white-50 small mb-0">Enter your email to receive a reset link</p>
        </div>

        <div class="card-body p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div><i class="fa fa-exclamation-circle me-1"></i>@err.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post" asp-action="ForgotPassword" asp-area="Customer" asp-controller="Account">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fa fa-envelope text-secondary"></i>
                        </span>
                        <input type="email" name="email" class="form-control border-start-0 ps-0"
                               placeholder="your@email.com" required autofocus />
                    </div>
                </div>

                <button type="submit" class="btn w-100 text-white fw-bold py-2 mt-2"
                        style="background:linear-gradient(135deg,#0f3460,#e94560);border:none;border-radius:10px">
                    <i class="fa fa-paper-plane me-2"></i>Send Reset Link
                </button>
            </form>

            <hr class="my-3">
            <div class="text-center">
                <a asp-area="Customer" asp-controller="Account" asp-action="Login"
                   class="text-decoration-none small" style="color:#0f3460">
                    <i class="fa fa-arrow-left me-1"></i>Back to Login
                </a>
            </div>
        </div>
    </div>
</div>
