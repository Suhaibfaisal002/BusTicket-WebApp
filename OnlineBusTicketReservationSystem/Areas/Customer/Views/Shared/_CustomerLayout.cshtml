<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SRC Travel Agencies</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/print-ticket.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --primary: #0f3460;
            --accent: #e94560;
            --accent-dark: #c0392b;
            --dark: #0f172a;
            --dark2: #1e293b;
            --muted: #94a3b8;
            --border: #e2e8f0;
            --light: #f8fafc;
            --font-head: 'Syne', sans-serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
            --nav-h: 70px;
            --radius: 14px;
            --shadow: 0 4px 24px rgba(0,0,0,0.08);
            --shadow-lg: 0 12px 48px rgba(0,0,0,0.14);
            --trans: 0.25s cubic-bezier(0.4,0,0.2,1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-body);
            background: #fff;
            color: #475569;
            line-height: 1.6;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }
        ul {
            list-style-type:none;
        }

        /* ── NAVBAR ── */
        .c-navbar {
            position: sticky;
            top: 0;
            z-index: 9999;
            height: var(--nav-h);
            background: rgba(15,23,42,0.97);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.07);
            display: flex;
            align-items: center;
        }

        .c-nav-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 1rem;
        }

        .c-logo {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            font-family: var(--font-head);
            font-size: 1.5rem;
            color: #fff;
            letter-spacing: 1px;
        }

            .c-logo .bus-anim {
                font-size: 1.8rem;
                animation: busRock 2s ease-in-out infinite;
            }

        @@keyframes busRock {
            0%, 100% {
                transform: rotate(-2deg);
            }

            50% {
                transform: rotate(2deg);
            }
        }

        .c-logo span {
            color: var(--accent);
        }

        .c-logo small {
            display: block;
            font-size: 0.55rem;
            color: var(--muted);
            font-weight: 400;
            letter-spacing: 0.5px;
            line-height: 1;
        }

        .c-nav-links {
            display: flex;
            align-items: center;
            gap: 0.2rem;
            list-style: none;
            flex: 1;
            justify-content: center;
        }

            .c-nav-links a {
                display: block;
                padding: 0.5rem 0.9rem;
                color: #cbd5e1;
                font-weight: 500;
                font-size: 0.88rem;
                border-radius: 8px;
                transition: all var(--trans);
            }

                .c-nav-links a:hover,
                .c-nav-links a.active {
                    color: #fff;
                    background: rgba(255,255,255,0.09);
                }

        /* Dropdown */
        .c-dropdown {
            position: relative;
        }

        .c-dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 50%;
            transform: translateX(-50%) translateY(-8px);
            min-width: 200px;
            background: #fff;
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
            padding: 0.4rem;
            opacity: 0;
            visibility: hidden;
            transition: all var(--trans);
            border: 1px solid var(--border);
        }

        .c-dropdown:hover .c-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
        }

        .c-dropdown-menu a {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.6rem 1rem;
            color: var(--dark);
            border-radius: 8px;
            font-size: 0.87rem;
            font-weight: 500;
        }

            .c-dropdown-menu a:hover {
                background: #fde8ea;
                color: var(--accent);
            }

        .c-nav-actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .btn-book {
            background: var(--accent);
            color: #fff;
            padding: 0.5rem 1.3rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.85rem;
            border: 2px solid var(--accent);
            transition: all var(--trans);
        }

            .btn-book:hover {
                background: var(--accent-dark);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(233,69,96,0.4);
            }

        .btn-login-nav {
            color: #cbd5e1;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.5rem 1rem;
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 8px;
            transition: all var(--trans);
        }

            .btn-login-nav:hover {
                color: #fff;
                border-color: rgba(255,255,255,0.4);
            }

        /* Hamburger */
        .c-hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            background: none;
            border: none;
            padding: 4px;
            cursor: pointer;
        }

            .c-hamburger span {
                display: block;
                width: 24px;
                height: 2px;
                background: #fff;
                border-radius: 2px;
                transition: var(--trans);
            }

        /* ── ALERTS ── */
        .alert-fixed {
            position: fixed;
            top: calc(var(--nav-h) + 10px);
            right: 1rem;
            z-index: 9999;
            min-width: 300px;
            max-width: 400px;
            animation: slideIn 0.3s ease;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* ── FOOTER ── */
        .c-footer {
            background: var(--dark);
        }

        .c-footer-top {
            padding: 4rem 0 3rem;
            max-width: 1280px;
            margin: 0 auto;
            padding-left: 1.5rem;
            padding-right: 1.5rem;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 3rem;
        }

        .c-footer-logo {
            font-family: var(--font-head);
            font-size: 1.8rem;
            color: #fff;
            letter-spacing: 1px;
            margin-bottom: 0.8rem;
        }

            .c-footer-logo span {
                color: var(--accent);
            }

        .c-footer-brand p {
            color: #475569;
            font-size: 0.88rem;
            line-height: 1.7;
            margin-bottom: 1.2rem;
        }

        .c-footer-socials {
            display: flex;
            gap: 0.5rem;
        }

        .c-fs-btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: rgba(255,255,255,0.07);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            transition: background var(--trans);
        }

            .c-fs-btn:hover {
                background: var(--accent);
            }

        .c-footer-col h5 {
            color: #fff;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 1.2rem;
        }

        .c-footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

            .c-footer-col ul li a {
                color: #475569;
                font-size: 0.87rem;
                transition: color var(--trans);
            }

                .c-footer-col ul li a:hover {
                    color: #fff;
                }

        .c-footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding: 1.2rem 1.5rem;
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

            .c-footer-bottom p {
                color: #334155;
                font-size: 0.82rem;
            }

        /* ── HERO (Reusable) ── */
        .c-inner-hero {
            position: relative;
            padding: 6rem 1.5rem 5rem;
            text-align: center;
            background-size: cover;
            background-position: center;
            overflow: hidden;
        }

        .c-hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( to bottom, rgba(15,23,42,0.85), rgba(15,23,42,0.7) );
        }

        .c-hero-content {
            position: relative;
            z-index: 1;
        }

            .c-hero-content h1 {
                font-family: var(--font-head);
                font-size: clamp(2.5rem,5vw,4rem);
                color: #fff;
                letter-spacing: 1px;
                line-height: 1.1;
                margin-bottom: 0.5rem;
            }

            .c-hero-content p {
                color: var(--muted);
            }

        .text-accent {
            color: var(--accent);
        }

        /* ── SECTION BADGE ── */
        .sec-badge {
            display: inline-block;
            background: #fde8ea;
            color: var(--accent);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 0.35rem 1rem;
            border-radius: 50px;
            margin-bottom: 0.8rem;
        }

            .sec-badge.white {
                background: rgba(255,255,255,0.15);
                color: #fff;
            }

        .sec-title {
            font-family: var(--font-head);
            font-size: 2.4rem;
            color: var(--dark);
            line-height: 1.15;
            margin-bottom: 0.5rem;
        }

        .sec-sub {
            color: var(--muted);
            font-size: 0.95rem;
            max-width: 500px;
            margin: 0 auto;
        }

        /* ── BUTTONS ── */
        .btn-red {
            background: var(--accent);
            color: #fff;
            padding: 0.75rem 2rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.9rem;
            border: 2px solid var(--accent);
            transition: all var(--trans);
            cursor: pointer;
        }

            .btn-red:hover {
                background: var(--accent-dark);
                border-color: var(--accent-dark);
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(233,69,96,0.35);
                color: #fff;
            }

        .btn-outline-dark {
            background: transparent;
            color: var(--dark);
            padding: 0.75rem 2rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.9rem;
            border: 2px solid var(--border);
            transition: all var(--trans);
        }

            .btn-outline-dark:hover {
                border-color: var(--dark);
                background: var(--light);
                color: var(--dark);
            }

        /* ── SCROLL TOP ── */
        .scroll-top {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--accent);
            color: #fff;
            border: none;
            font-size: 1rem;
            box-shadow: 0 4px 20px rgba(233,69,96,0.4);
            cursor: pointer;
            opacity: 0;
            pointer-events: none;
            transition: all var(--trans);
            z-index: 9998;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .scroll-top.visible {
                opacity: 1;
                pointer-events: all;
            }

            .scroll-top:hover {
                transform: translateY(-3px);
            }

        /* ── RESPONSIVE ── */
        @@media (max-width: 992px) {
            .c-footer-top {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 768px) {
            .c-hamburger {
                display: flex;
            }

            .c-nav-links {
                position: fixed;
                top: var(--nav-h);
                left: 0;
                right: 0;
                background: rgba(15,23,42,0.99);
                backdrop-filter: blur(20px);
                flex-direction: column;
                align-items: stretch;
                padding: 1rem;
                gap: 0.2rem;
                transform: translateY(-110%);
                transition: transform var(--trans);
                z-index: 9998;
                max-height: calc(100vh - var(--nav-h));
                overflow-y: auto;
            }

                .c-nav-links.open {
                    transform: translateY(0);
                }

                .c-nav-links a {
                    padding: 0.8rem 1rem;
                }

            .c-dropdown-menu {
                position: static;
                transform: none;
                opacity: 1;
                visibility: visible;
                box-shadow: none;
                background: rgba(255,255,255,0.04);
                border: none;
                margin: 0.2rem 0;
            }

                .c-dropdown-menu a {
                    color: #94a3b8;
                }

            .btn-book {
                display: none;
            }

            .c-footer-top {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
        }

        @@media (max-width: 576px) {
            .sec-title {
                font-size: 1.8rem;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- NAVBAR -->
    <nav class="c-navbar">
        <div class="c-nav-inner">
            <!-- Logo -->
            <a asp-area="Customer"
               asp-controller="Home"
               asp-action="Index"
               class="c-logo">
                <div class="bus-anim">🚌</div>
                <div>
                    <div>SRC<span>Travel</span></div>
                    <small>Pakistan's Trusted Bus Network</small>
                </div>
            </a>

            <!-- Nav Links -->
            <ul class="c-nav-links" id="cNavLinks">
                <li>
                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Index"
                       class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        Home
                    </a>
                </li>
                <li>
                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="About"
                       class="@(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")">
                        About
                    </a>
                </li>
                <li class="c-dropdown">
                    <a style="cursor:pointer">
                        Services <small>▾</small>
                    </a>
                    <ul class="c-dropdown-menu">
                        <li>
                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Services">
                                <i class="fa fa-ticket-alt"></i>Online Booking
                            </a>
                        </li>
                        <li>
                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Cancellation">
                                <i class="fa fa-undo"></i>Cancellation Policy
                            </a>
                        </li>
                        <li>
                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="PriceList">
                                <i class="fa fa-tags me-2"></i>Price List
                            </a>
                        </li>
                        <li>
                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Faqs">
                                <i class="fa fa-question-circle me-2"></i>FAQs
                            </a>
                        </li>
                    </ul>
                </li>
                <li>
                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Contact"
                       class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")">
                        Contact
                    </a>
                </li>
                @if (User.Identity?.IsAuthenticated == true
                                && User.IsInRole("Customer"))
                {
                    <li class="c-dropdown">
                        <a style="cursor:pointer">
                            <i class="fa fa-user-circle me-1"></i>
                            My Account <small>▾</small>
                        </a>
                        <ul class="c-dropdown-menu">
                            <li>
                                <a asp-area="Customer"
                                   asp-controller="Booking"
                                   asp-action="Dashboard">
                                    <i class="fa fa-tachometer-alt"></i>Dashboard
                                </a>
                            </li>
                            <li>
                                <a asp-area="Customer"
                                   asp-controller="Booking"
                                   asp-action="Search">
                                    <i class="fa fa-search"></i>Search Buses
                                </a>
                            </li>
                            <li>
                                <a asp-area="Customer"
                                   asp-controller="Booking"
                                   asp-action="MyBookings">
                                    <i class="fa fa-ticket-alt"></i>My Bookings
                                </a>
                            </li>
                            <li>
                                <a asp-area="Customer"
                                   asp-controller="Booking"
                                   asp-action="PaymentHistory">
                                    <i class="fa fa-credit-card"></i>Payment History
                                </a>
                            </li>
                            <li>
                                <a asp-area="Customer"
                                   asp-controller="Account"
                                   asp-action="Profile">
                                    <i class="fa fa-user-edit"></i>My Profile
                                </a>
                            </li>
                            <li>
                                <a asp-area=""
                                   asp-controller="Account"
                                   asp-action="ChangePassword">
                                    <i class="fa fa-key"></i>Change Password
                                </a>
                            </li>
                        </ul>
                    </li>
                }
            </ul>

            <!-- Nav Actions -->
            <div class="c-nav-actions">
                @if (User.Identity?.IsAuthenticated == true
                                && User.IsInRole("Customer"))
                {
                    <a asp-area="Customer"
                       asp-controller="Booking"
                       asp-action="Search"
                       class="btn-book">
                        <i class="fa fa-search me-1"></i>Search Buses
                    </a>
                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post" class="d-inline">
                        <button type="submit" class="btn-login-nav">
                            <i class="fa fa-sign-out-alt me-1"></i>Logout
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Customer"
                       asp-controller="Account"
                       asp-action="Login"
                       class="btn-login-nav">
                        <i class="fa fa-sign-in-alt me-1"></i>Login
                    </a>
                    <a asp-area="Customer"
                       asp-controller="Booking"
                       asp-action="Search"
                       class="btn-book">
                        <i class="fa fa-ticket-alt me-1"></i>Book Now
                    </a>
                }
                <button class="c-hamburger" id="cHamburger"
                        onclick="toggleCNav()">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </nav>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible alert-fixed">
            <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible alert-fixed">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- MAIN CONTENT -->
    @RenderBody()

    <!-- FOOTER -->
    <footer class="c-footer">
        <div class="c-footer-top">
            <div class="c-footer-brand">
                <div class="c-footer-logo">
                    SRC<span>Travel</span>
                </div>
                <p>Pakistan's trusted bus reservation platform. Safe, affordable, and on-time travel across 50+ cities.</p>
                <div class="c-footer-socials">
                    <a class="c-fs-btn"><i class="fab fa-facebook-f"></i></a>
                    <a class="c-fs-btn"><i class="fab fa-twitter"></i></a>
                    <a class="c-fs-btn"><i class="fab fa-instagram"></i></a>
                    <a class="c-fs-btn"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
            <div class="c-footer-col">
                <h5>Quick Links</h5>
                <ul>
                    <li><a asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-area="Customer" asp-controller="Home" asp-action="About">About Us</a></li>
                    <li><a asp-area="Customer" asp-controller="Home" asp-action="Services">Services</a></li>
                    <li><a asp-area="Customer" asp-controller="Home" asp-action="Faqs">FAQs</a></li>
                    <li><a asp-area="Customer" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    <li>
                        <a asp-area="Customer"
                           asp-controller="Home"
                           asp-action="PrivacyPolicy">
                            Privacy Policy
                        </a>
                    </li>
                </ul>
            </div>
            <div class="c-footer-col">
                <h5>Services</h5>
                <ul>
                    <li><a asp-area="Customer" asp-controller="Booking" asp-action="Search">Book Now</a></li>
                    <li><a asp-area="Customer" asp-controller="Home" asp-action="PriceList">Price List</a></li>
                    <li><a asp-area="Customer" asp-controller="Home" asp-action="Cancellation">Cancellation Policy</a></li>
                    <li><a asp-area="Customer" asp-controller="Home" asp-action="Faqs">FAQs</a></li>
                </ul>
            </div>
            <div class="c-footer-col">
                <h5>Contact</h5>
                <ul>
                    <li><a><i class="fa fa-map-marker-alt me-2"></i>Karachi, Pakistan</a></li>
                    <li><a><i class="fa fa-phone me-2"></i>+92-21-1234567</a></li>
                    <li><a><i class="fa fa-envelope me-2"></i>info@srctravel.com</a></li>
                </ul>
            </div>
        </div>
        <div class="c-footer-bottom">
            <p>© @DateTime.Now.Year SRC Travel Agencies. All rights reserved.</p>
            <p>Made with ❤️ in Pakistan</p>
        </div>
    </footer>

    <!-- Scroll Top -->
    <button class="scroll-top" id="scrollTop"
            onclick="window.scrollTo({top:0,behavior:'smooth'})">
        <i class="fa fa-arrow-up"></i>
    </button>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Hamburger
        function toggleCNav() {
            document.getElementById('cNavLinks')
                .classList.toggle('open');
        }

        // Scroll top
        window.addEventListener('scroll', () => {
            const btn = document.getElementById('scrollTop');
            btn.classList.toggle('visible', window.scrollY > 300);
        });

        // Auto-dismiss alerts
        setTimeout(() => {
            document.querySelectorAll('.alert-fixed')
                .forEach(a => a.remove());
        }, 4000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
