@{
    ViewData["Title"] = "Revenue Report";
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Now.Year;
    var years = ViewBag.Years as List<int> ?? new List<int>();
    var monthly = ViewBag.MonthlyData as dynamic;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="fa fa-chart-line me-2 text-success"></i>Revenue Report</h4>
        <p class="text-muted mb-0">Annual revenue breakdown by month</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary d-print-none">
        <i class="fa fa-print me-1"></i>Print
    </button>
</div>

<!-- Tabs -->
<!-- Report Navigation Tabs -->
<ul class="nav nav-tabs mb-4 d-print-none" style="flex-wrap:wrap">
    <li class="nav-item">
        <a class="nav-link fw-semibold" style="text-decoration:none"
           asp-area="Admin" asp-controller="Reports" asp-action="Index">📊 Booking Report</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active fw-semibold" style="text-decoration:none"
           asp-area="Admin" asp-controller="Reports" asp-action="RevenueReport">💰 Revenue Report</a>
    </li>
    <li class="nav-item">
        <a class="nav-link fw-semibold" style="text-decoration:none"
           asp-area="Admin" asp-controller="Reports" asp-action="BusUtilization">🚌 Bus Utilization</a>
    </li>
</ul>

<!-- Year Filter -->
<div class="card border-0 shadow-sm mb-4 d-print-none">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Select Year</label>
                <select name="year" class="form-select" onchange="this.form.submit()">
                    @foreach (var y in years)
                    {
                        if (y == selectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Summary Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-4 fw-bold text-success">Rs. @(((decimal)ViewBag.TotalGross).ToString("N0"))</div>
            <div class="text-muted small">Gross Revenue</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-4 fw-bold text-primary">Rs. @(((decimal)ViewBag.TotalNet).ToString("N0"))</div>
            <div class="text-muted small">Net Revenue</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-4 fw-bold text-warning">Rs. @(((decimal)ViewBag.TotalTax).ToString("N0"))</div>
            <div class="text-muted small">Tax (5%)</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-4 fw-bold text-danger">@ViewBag.PendingRefunds</div>
            <div class="text-muted small">Pending Refunds</div>
        </div>
    </div>
</div>

<!-- Chart -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-bold bg-transparent">Monthly Revenue — @selectedYear</div>
    <div class="card-body">
        <canvas id="revenueChart" height="80"></canvas>
    </div>
</div>

<!-- Monthly Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header fw-bold bg-transparent">Monthly Breakdown</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Month</th>
                        <th>Bookings</th>
                        <th>Gross Revenue</th>
                        <th>Tax (5%)</th>
                        <th>Net Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.MonthlyData != null)
                    {
                        foreach (var m in ViewBag.MonthlyData)
                        {
                            <tr>
                                <td class="fw-semibold">@m.Month</td>
                                <td>@m.Count</td>
                                <td>Rs. @(((decimal)m.Gross).ToString("N0"))</td>
                                <td class="text-muted">Rs. @(((decimal)m.Tax).ToString("N0"))</td>
                                <td class="fw-bold text-success">Rs. @(((decimal)m.Net).ToString("N0"))</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="2" class="fw-bold">Total</td>
                        <td class="fw-bold">Rs. @(((decimal)ViewBag.TotalGross).ToString("N0"))</td>
                        <td class="fw-bold text-muted">Rs. @(((decimal)ViewBag.TotalTax).ToString("N0"))</td>
                        <td class="fw-bold text-success">Rs. @(((decimal)ViewBag.TotalNet).ToString("N0"))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
    const labels  = @Html.Raw(ViewBag.ChartLabels ?? "[]");
    const gross   = @Html.Raw(ViewBag.ChartGross  ?? "[]");
    const net     = @Html.Raw(ViewBag.ChartNet    ?? "[]");

    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels,
            datasets: [
                { label: 'Gross Revenue', data: gross, backgroundColor: 'rgba(15,52,96,0.7)', borderRadius: 6 },
                { label: 'Net Revenue',   data: net,   backgroundColor: 'rgba(22,163,74,0.7)', borderRadius: 6 }
            ]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'top' } },
            scales: { y: { beginAtZero: true, ticks: { callback: v => 'Rs.' + v.toLocaleString() } } }
        }
    });
</script>
}
