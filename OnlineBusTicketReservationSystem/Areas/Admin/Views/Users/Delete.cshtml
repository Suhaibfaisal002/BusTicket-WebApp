@model OnlineBusTicketReservationSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "Delete Employee";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="fa fa-exclamation-triangle me-2"></i>
                    Confirm Delete Employee
                </h5>
            </div>
            <div class="card-body">
                <p class="text-danger fw-semibold">
                    Are you sure you want to delete this employee?
                </p>
                <table class="table table-borderless table-sm">
                    <tr>
                        <th>Employee Code</th>
                        <td>@Model.EmployeeCode</td>
                    </tr>
                    <tr><th>Name</th><td>@Model.FullName</td></tr>
                    <tr><th>Email</th><td>@Model.Email</td></tr>
                    <tr><th>Location</th><td>@(Model.Location ?? "N/A")</td></tr>
                </table>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fa fa-trash me-1"></i>Yes, Delete
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-times me-1"></i>Cancel
                </a>
            </div>
        </div>
    </div>
</div>