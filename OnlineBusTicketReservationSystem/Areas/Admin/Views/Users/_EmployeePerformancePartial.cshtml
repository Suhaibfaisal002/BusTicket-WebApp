@{
    var performance = ViewBag.Performance as dynamic;
}

<!-- Date Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="EmployeePerformancePartial" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold small">From Date</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small">To Date</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fa fa-search me-1"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3" style="border-left:4px solid #0f3460!important">
            <div class="fs-4 fw-bold text-primary">Rs.@((ViewBag.TotalEmpRevenue ?? 0m).ToString("N0"))</div>
            <div class="text-muted small">Total Revenue (Period)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3" style="border-left:4px solid #16a34a!important">
            <div class="fs-4 fw-bold text-success">@(ViewBag.TopPerformer ?? "—")</div>
            <div class="text-muted small">Top Performer</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3" style="border-left:4px solid #e94560!important">
            <div class="fs-4 fw-bold" style="color:#e94560">@(((IEnumerable<dynamic>)ViewBag.Performance)?.Count() ?? 0)</div>
            <div class="text-muted small">Active Employees</div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background:linear-gradient(135deg,#0f3460,#e94560);color:#fff">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Total Bookings</th>
                        <th>Confirmed</th>
                        <th>Cancelled</th>
                        <th>Pending</th>
                        <th>Revenue</th>
                        <th>Success Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.Performance != null)
                    {
                        int rank = 1;
                        foreach (var emp in ViewBag.Performance)
                        {
                            double rate = (double)emp.SuccessRate;
                            string rateColor = rate >= 80 ? "#16a34a" : rate >= 50 ? "#f59e0b" : "#ef4444";
                            <tr>
                                <td>
                                    @if (rank == 1)
                                    {
                                        <span>🥇</span>
                                    }
                                    else if (rank == 2)
                                    {
                                        <span>🥈</span>
                                    }
                                    else if (rank == 3)
                                    {
                                        <span>🥉</span>
                                    }
                                    <span class="badge bg-secondary ms-1">@emp.EmpCode</span>
                                </td>
                                <td class="fw-semibold">@emp.FullName</td>
                                <td>@emp.TotalBookings</td>
                                <td><span class="badge bg-success">@emp.Confirmed</span></td>
                                <td><span class="badge bg-danger">@emp.Cancelled</span></td>
                                <td><span class="badge bg-warning text-dark">@emp.Pending</span></td>
                                <td class="fw-bold" style="color:#0f3460">Rs.@(((decimal)emp.Revenue).ToString("N0"))</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:60px;height:6px;background:#e2e8f0;border-radius:99px;overflow:hidden">
                                            <div style="height:100%;width:@rate.ToString("F0")%;background:@rateColor;border-radius:99px"></div>
                                        </div>
                                        <span style="font-size:0.8rem;font-weight:700;color:@rateColor">@emp.SuccessRate%</span>
                                    </div>
                                </td>
                            </tr>
                            rank++;
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (ViewBag.Performance == null || !((IEnumerable<dynamic>)ViewBag.Performance).Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fa fa-chart-bar fa-3x mb-3 d-block opacity-25"></i>
                No bookings found for this period.
            </div>
        }
    </div>
</div>
