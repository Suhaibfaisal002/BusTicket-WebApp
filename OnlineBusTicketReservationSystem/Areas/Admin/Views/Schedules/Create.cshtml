@model OnlineBusTicketReservationSystem.Models.Schedule
@{
    ViewData["Title"] = "Add Schedule";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header text-white" style="background:linear-gradient(135deg,#0f3460,#e94560)">
                <h5 class="mb-0">
                    <i class="fa fa-plus me-2"></i>Add New Schedule
                </h5>
            </div>
            <div class="card-body p-4">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="BusId" class="form-label fw-semibold">Bus</label>
                        <select asp-for="BusId" asp-items="@(ViewData["BusId"] as IEnumerable<SelectListItem>)" class="form-select">
                            <option value="">-- Select Bus --</option>
                        </select>
                           
                        <span asp-validation-for="BusId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RouteId" class="form-label fw-semibold">Route</label>
                        <select asp-for="RouteId" asp-items="@(ViewData["RouteId"] as IEnumerable<SelectListItem>)" class="form-select">
                            <option value="">-- Select Route --</option>
                        </select>
                          
                        <span asp-validation-for="RouteId" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="DepartureTime" class="form-label fw-semibold"></label>
                            <input asp-for="DepartureTime" type="datetime-local" class="form-control" step="1" />
                            <span asp-validation-for="DepartureTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ArrivalTime" class="form-label fw-semibold"></label>
                            <input asp-for="ArrivalTime" type="datetime-local" class="form-control" step="1" />
                            <span asp-validation-for="ArrivalTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-1"></i>Create Schedule
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa fa-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}