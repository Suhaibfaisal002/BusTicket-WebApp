@model IEnumerable<OnlineBusTicketReservationSystem.Models.Schedule>
@{
    ViewData["Title"] = "Schedules";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="fa fa-calendar-alt me-2 text-primary"></i>
            Schedule Management
        </h4>
        <p class="text-muted mb-0">Manage bus departure schedules</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>Add Schedule
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background:linear-gradient(135deg,#0f3460,#e94560);color:white;">
                    <tr>
                        <th>#</th>
                        <th>Bus</th>
                        <th>Route</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                        @* <th>Seats</th> *@
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary">
                                    @s.ScheduleId
                                </span>
                            </td>
                            <td>
                                <strong>@s.Bus?.BusNumber</strong><br />
                                <small class="text-muted">
                                    @s.Bus?.BusType
                                </small>
                            </td>
                            <td>
                                <small>
                                    <i class="fa fa-map-marker-alt text-success me-1"></i>
                                    @s.Route?.SourceCity<br />
                                    <i class="fa fa-map-marker-alt text-danger me-1"></i>
                                    @s.Route?.DestinationCity
                                </small>
                            </td>
                            <td>
                                <span class="fw-semibold">
                                    @s.DepartureTime.ToString("dd-MMM-yyyy")
                                </span><br />
                                <small class="text-muted">
                                    @s.DepartureTime.ToString("HH:mm")
                                </small>
                            </td>
                            <td>
                                <span class="fw-semibold">
                                    @s.ArrivalTime.ToString("dd-MMM-yyyy")
                                </span><br />
                                <small class="text-muted">
                                    @s.ArrivalTime.ToString("HH:mm")
                                </small>
                            </td>
                            @* <td>
                                @if (s.AvailableSeats > 10)
                                {
                                    <span class="badge bg-success">
                                        @s.AvailableSeats seats
                                    </span>
                                }
                                else if (s.AvailableSeats > 0)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @s.AvailableSeats left!
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Full</span>
                                }
                            </td>*@
                            <td> 
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit"
                                       asp-route-id="@s.ScheduleId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <form asp-action="ToggleStatus"
                                          asp-route-id="@s.ScheduleId"
                                          method="post" class="d-inline">
                                        <button type="submit"
                                                class="btn btn-sm @(s.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                            <i class="fa @(s.IsActive ? "fa-pause" : "fa-play")"></i>
                                        </button>
                                    </form>
                                    <a asp-action="Delete"
                                       asp-route-id="@s.ScheduleId"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fa fa-calendar fa-3x mb-3 d-block opacity-25"></i>
                No schedules found.
                <a asp-action="Create">Add your first schedule.</a>
            </div>
        }
    </div>
</div>