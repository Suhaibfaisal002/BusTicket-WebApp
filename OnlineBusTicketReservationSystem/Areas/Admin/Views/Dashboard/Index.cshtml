@model OnlineBusTicketReservationSystem.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="fa fa-tachometer-alt me-2 text-primary"></i>
            Admin Dashboard
        </h4>
        <p class="text-muted mb-0">
            Welcome back! Here's what's happening at SRC Travel.
        </p>
    </div>
    <span class="text-muted small">
        <i class="fa fa-calendar me-1"></i>
        @DateTime.Now.ToString("dddd, dd MMMM yyyy")
    </span>
</div>

<!-- Pending Bookings Alert -->
@if (ViewBag.PendingBookings != null && (int)ViewBag.PendingBookings > 0)
{
    <div class="alert d-flex align-items-center justify-content-between mb-4" id="pendingAlert"
         style="background:#fffbeb;border:1.5px solid #f59e0b;border-radius:12px;padding:1rem 1.5rem">
        <div class="d-flex align-items-center gap-3">
            <span style="font-size:1.8rem">⏳</span>
            <div>
                <div class="fw-bold" style="color:#92400e">
                    <span id="live-pending">@ViewBag.PendingBookings</span> booking@(ViewBag.PendingBookings > 1 ? "s are" : " is") waiting for confirmation!
                </div>
                <div class="small" style="color:#b45309">
                    Please review and confirm or cancel pending bookings.
                </div>
            </div>
        </div>
        <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" asp-route-status="Pending"
           class="btn btn-sm fw-bold"
           style="background:#f59e0b;color:#fff;border-radius:8px;white-space:nowrap">
            View Pending →
        </a>
    </div>
}

<!-- Stats Row 1 -->
<div class="row g-3 mb-3">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#0f3460,#1a4a8a)">
            <div>
                <p class="mb-1 small opacity-75">Total Buses</p>
                <div class="stat-num">@Model.TotalBuses</div>
                <small class="opacity-60">@Model.ActiveBuses Active</small>
            </div>
            <i class="fa fa-bus stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#e94560,#c0392b)">
            <div>
                <p class="mb-1 small opacity-75">Routes</p>
                <div class="stat-num">@Model.TotalRoutes</div>
                <small class="opacity-60">Active Routes</small>
            </div>
            <i class="fa fa-route stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#198754,#145c38)">
            <div>
                <p class="mb-1 small opacity-75">Bookings</p>
                <div class="stat-num" id="live-total">@Model.TotalBookings</div>
                <small class="opacity-60">
                    <span id="live-cancelled">@Model.TotalCancellations</span> Cancelled
                </small>
            </div>
            <i class="fa fa-ticket-alt stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#fd7e14,#c96a00)">
            <div>
                <p class="mb-1 small opacity-75">Revenue</p>
                <div class="stat-num" id="live-revenue" style="font-size:1.4rem">
                    Rs.@Model.TotalRevenue.ToString("N0")
                </div>
                <small class="opacity-60">Total Collected</small>
            </div>
            <i class="fa fa-money-bill-wave stat-icon"></i>
        </div>
    </div>
</div>

<!-- Stats Row 2 -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#6f42c1,#4a1f9e)">
            <div>
                <p class="mb-1 small opacity-75">Employees</p>
                <div class="stat-num">@Model.TotalEmployees</div>
                <small class="opacity-60">Active Staff</small>
            </div>
            <i class="fa fa-users stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card d-flex align-items-center justify-content-between"
             style="background:linear-gradient(135deg,#0dcaf0,#0a8aab)">
            <div>
                <p class="mb-1 small opacity-75">Schedules</p>
                <div class="stat-num">@Model.TotalSchedules</div>
                <small class="opacity-60">Total Schedules</small>
            </div>
            <i class="fa fa-calendar-alt stat-icon"></i>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card mb-4">
    <div class="card-body d-flex gap-2 flex-wrap p-3">
        <a asp-area="Admin" asp-controller="Buses"
           asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus me-1"></i>Add Bus
        </a>
        <a asp-area="Admin" asp-controller="Routes"
           asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus me-1"></i>Add Route
        </a>
        <a asp-area="Admin" asp-controller="Schedules"
           asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus me-1"></i>Add Schedule
        </a>
        <a asp-area="Admin" asp-controller="PriceLists"
           asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus me-1"></i>Add Price
        </a>
        <a asp-area="Admin" asp-controller="Users"
           asp-action="Create" class="btn btn-success btn-sm">
            <i class="fa fa-user-plus me-1"></i>Add Employee
        </a>
    </div>
</div>

<!-- Recent Bookings -->
<div class="card">
    <div class="card-header text-white"
         style="background:linear-gradient(135deg,#0f3460,#e94560)">
        <h6 class="mb-0">
            <i class="fa fa-history me-2"></i>Recent Bookings
        </h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentBookings.Any())
        {
            <div class="text-center text-muted py-4">
                No bookings yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Customer</th>
                            <th>Route</th>
                            <th>Bus</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">
                                        #@b.BookingId
                                    </span>
                                </td>
                                <td>@b.CustomerName</td>
                                <td>
                                    <small>
                                        @b.Schedule?.Route?.SourceCity →
                                        @b.Schedule?.Route?.DestinationCity
                                    </small>
                                </td>
                                <td>
                                    <small>@b.Schedule?.Bus?.BusNumber</small>
                                </td>
                                <td>
                                    <small>
                                        @b.BookingDate.ToString("dd-MMM-yy HH:mm")
                                    </small>
                                </td>
                                <td>
                                    <strong>Rs.@b.TotalAmount.ToString("N2")</strong>
                                </td>
                                <td>
                                    @if (b.BookingStatus == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            Confirmed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div></div>

<!-- Revenue Chart -->
<div class="row g-3 mt-1">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-bold">📈 Monthly Revenue (Last 6 Months)</span>
                <small class="text-muted">Confirmed bookings only</small>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent fw-bold">📊 Booking Status</div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    // ✅ Live stats polling — har 30 seconds mein update
    function refreshStats() {
        fetch('/Admin/Bookings/LiveStats')
            .then(r => r.json())
            .then(d => {
                const pending   = document.getElementById('live-pending');
                const total     = document.getElementById('live-total');
                const cancelled = document.getElementById('live-cancelled');
                const revenue   = document.getElementById('live-revenue');

                if (pending)   pending.textContent   = d.pending;
                if (total)     total.textContent     = d.total;
                if (cancelled) cancelled.textContent = d.cancelled;
                if (revenue)   revenue.textContent   = 'Rs.' + d.revenue.toLocaleString('en-PK', {maximumFractionDigits:0});

                // Alert hide karo agar pending 0 ho gaye
                const alert = document.getElementById('pendingAlert');
                if (alert && d.pending === 0) alert.style.display = 'none';
            })
            .catch(() => {}); // silently fail
    }
    setInterval(refreshStats, 30000); // 30 sec

    // Revenue Line Chart
    const labels   = @Html.Raw(ViewBag.MonthLabels);
    const revenues = @Html.Raw(ViewBag.MonthRevenues);

    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Revenue (Rs.)',
                data: revenues,
                backgroundColor: 'rgba(233,69,96,0.15)',
                borderColor: '#e94560',
                borderWidth: 2,
                borderRadius: 8,
                fill: true
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: v => 'Rs. ' + v.toLocaleString()
                    }
                }
            }
        }
    });

    // Status Donut Chart
    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: ['Pending', 'Confirmed', 'Cancelled'],
            datasets: [{
                data: [@ViewBag.PendingBookings, @ViewBag.ConfirmedBookings, @ViewBag.CancelledBookings],
                backgroundColor: ['#fbbf24', '#22c55e', '#ef4444'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            cutout: '65%',
            plugins: {
                legend: { position: 'bottom', labels: { padding: 15 } }
            }
        }
    });
</script>
}
