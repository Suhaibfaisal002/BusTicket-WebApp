@model OnlineBusTicketReservationSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1"><i class="fa fa-user-edit me-2 text-primary"></i>My Profile</h4>
    <p class="text-muted mb-0">Manage your admin account information</p>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <!-- Avatar Card -->
        <div class="card text-center p-4 mb-3">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle text-white fw-bold"
                 style="width:90px;height:90px;font-size:2rem;background:linear-gradient(135deg,#0f3460,#e94560)">
                @(Model.FullName?.Substring(0,1).ToUpper() ?? "A")
            </div>
            <h5 class="fw-bold mb-1">@Model.FullName</h5>
            <p class="text-muted small mb-1">@Model.Email</p>
            <span class="badge" style="background:#0f3460">Administrator</span>
            <div class="mt-3 text-muted small">
                <i class="fa fa-calendar me-1"></i>Joined @Model.CreatedAt.ToString("dd MMM yyyy")
            </div>
        </div>

        <!-- Change Password -->
        <div class="card p-3">
            <h6 class="fw-bold mb-3"><i class="fa fa-key me-2 text-warning"></i>Change Password</h6>
            <a asp-area="" asp-controller="Account" asp-action="ChangePassword"
               class="btn btn-outline-warning w-100">
                <i class="fa fa-lock me-2"></i>Change Password
            </a>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header text-white" style="background:linear-gradient(135deg,#0f3460,#e94560)">
                <h6 class="mb-0"><i class="fa fa-edit me-2"></i>Edit Profile</h6>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="fullName" value="@Model.FullName"
                                   class="form-control" required placeholder="Your full name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" value="@Model.Email" class="form-control" disabled />
                            <small class="text-muted">Email cannot be changed</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone</label>
                            <input type="text" name="phone" value="@Model.PhoneNumber"
                                   class="form-control" placeholder="03XX-XXXXXXX" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Gender</label>
                            <select name="gender" class="form-select">
                                <option value="">Select</option>
                                @if (Model.Gender == "Male")
                                {
                                    <option value="Male" selected>Male</option>
                                }
                                else
                                {
                                    <option value="Male">Male</option>
                                }
                                @if (Model.Gender == "Female")
                                {
                                    <option value="Female" selected>Female</option>
                                }
                                else
                                {
                                    <option value="Female">Female</option>
                                }
                                @if (Model.Gender == "Other")
                                {
                                    <option value="Other" selected>Other</option>
                                }
                                else
                                {
                                    <option value="Other">Other</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Age</label>
                            <input type="number" name="age" value="@Model.Age"
                                   class="form-control" min="18" max="99" placeholder="Age" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Address</label>
                            <input type="text" name="address" value="@Model.Address"
                                   class="form-control" placeholder="Street address" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">City / Location</label>
                            <input type="text" name="location" value="@Model.Location"
                                   class="form-control" placeholder="City" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Qualification</label>
                            <input type="text" name="qualification" value="@Model.Qualification"
                                   class="form-control" placeholder="e.g. MBA, BSc Computer Science" />
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">
                            <i class="fa fa-save me-2"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
