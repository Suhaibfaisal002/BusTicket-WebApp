@model OnlineBusTicketReservationSystem.Models.ContactMessage
@{
    ViewData["Title"] = "Message Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">← Back to Messages</a>
        <h4 class="fw-bold mb-0 mt-1">Message from @Model.Name</h4>
    </div>
    <form asp-action="Delete" asp-route-id="@Model.MessageId" method="post"
          onsubmit="return confirm('Delete this message?')">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-danger btn-sm">
            <i class="fa fa-trash me-1"></i> Delete
        </button>
    </form>
</div>

<div class="card border-0 shadow-sm" style="max-width:700px">
    <div class="card-body">
        <table class="table table-sm table-borderless mb-3">
            <tr>
                <td class="text-muted" style="width:100px">From</td>
                <td class="fw-semibold">@Model.Name</td>
            </tr>
            <tr>
                <td class="text-muted">Email</td>
                <td><a href="mailto:@Model.Email">@Model.Email</a></td>
            </tr>
            @if (!string.IsNullOrEmpty(Model.Subject))
            {
                <tr>
                    <td class="text-muted">Subject</td>
                    <td class="fw-semibold">@Model.Subject</td>
                </tr>
            }
            <tr>
                <td class="text-muted">Received</td>
                <td>@Model.SentAt.ToString("dd MMM yyyy, hh:mm tt")</td>
            </tr>
        </table>

        <hr />

        <div style="white-space:pre-wrap;line-height:1.8;color:#374151">@Model.Message</div>

        <hr />

        <a href="mailto:@Model.Email?subject=Re: @Model.Subject"
           class="btn btn-primary btn-sm">
            <i class="fa fa-reply me-1"></i> Reply via Email
        </a>
    </div>
</div>
