@model OnlineBusTicketReservationSystem.Models.Route
@{
    ViewData["Title"] = "Delete Route";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="fa fa-exclamation-triangle me-2"></i>
                    Confirm Delete Route
                </h5>
            </div>
            <div class="card-body">
                <p class="text-danger fw-semibold">
                    Are you sure you want to delete this route?
                </p>
                <table class="table table-borderless table-sm">
                    <tr><th>From</th><td>@Model.SourceCity</td></tr>
                    <tr><th>To</th><td>@Model.DestinationCity</td></tr>
                    <tr>
                        <th>Distance</th>
                        <td>
                            @(Model.DistanceKm.HasValue
                                                        ? $"{Model.DistanceKm} km" : "N/A")
                        </td>
                    </tr>
                    <tr>
                        <th>Stops</th>
                        <td>@(Model.RouteStops?.Count ?? 0)</td>
                    </tr>
                </table>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id"
                           value="@Model.RouteId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fa fa-trash me-1"></i>Yes, Delete
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-times me-1"></i>Cancel
                </a>
            </div>
        </div>
    </div>
</div>