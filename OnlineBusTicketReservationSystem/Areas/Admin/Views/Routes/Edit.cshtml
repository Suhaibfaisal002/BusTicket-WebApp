@model OnlineBusTicketReservationSystem.Models.Route
@{
    ViewData["Title"] = "Edit Route";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header text-white"
                 style="background:linear-gradient(135deg,#0f3460,#e94560)">
                <h5 class="mb-0">
                    <i class="fa fa-edit me-2"></i>Edit Route
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="RouteId" />
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="SourceCity"
                                   class="form-label fw-semibold"></label>
                            <input asp-for="SourceCity"
                                   class="form-control" />
                            <span asp-validation-for="SourceCity"
                                  class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DestinationCity"
                                   class="form-label fw-semibold"></label>
                            <input asp-for="DestinationCity"
                                   class="form-control" />
                            <span asp-validation-for="DestinationCity"
                                  class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="DistanceKm"
                                   class="form-label fw-semibold"></label>
                            <input asp-for="DistanceKm"
                                   class="form-control"
                                   type="number" step="0.1" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EstimatedDuration"
                                   class="form-label fw-semibold">
                                Est. Duration (HH:MM:SS)
                            </label>
                            <input asp-for="EstimatedDuration"
                                   class="form-control" />
                        </div>
                    </div>

                    <!-- Existing Stops -->
                    <div class="card mb-4 border-0 bg-light">
                        <div class="card-body">
                            <div class="d-flex align-items-center
                                        justify-content-between mb-3">
                                <h6 class="mb-0 fw-semibold">
                                    <i class="fa fa-map-pin me-2"></i>
                                    Route Stops
                                </h6>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        onclick="addStop()">
                                    <i class="fa fa-plus me-1"></i>Add Stop
                                </button>
                            </div>
                            <div id="stopsContainer">
                                @if (Model.RouteStops != null)
                                {
                                    @foreach (var stop in Model.RouteStops
                                                                    .OrderBy(s => s.StopOrder))
                                    {
                                        <div class="row g-2 mb-2 align-items-center stop-row">
                                            <div class="col-md-5">
                                                <input type="text"
                                                       name="StopNames"
                                                       class="form-control form-control-sm"
                                                       value="@stop.StopName" />
                                            </div>
                                            <div class="col-md-2">
                                                <input type="number"
                                                       name="StopOrders"
                                                       class="form-control form-control-sm"
                                                       value="@stop.StopOrder" />
                                            </div>
                                            <div class="col-md-4">
                                                <div class="input-group input-group-sm">
                                                    <input type="number"
                                                           name="StopDistances"
                                                           class="form-control"
                                                           value="@stop.DistanceFromSource"
                                                           step="0.1" />
                                                    <span class="input-group-text">km</span>
                                                </div>
                                            </div>
                                            <div class="col-md-1">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="this.closest('.stop-row').remove()">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa fa-arrow-left me-1"></i>Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let stopCount = @(Model.RouteStops?.Count ?? 0);
        function addStop() {
            stopCount++;
            const div = document.createElement('div');
            div.className = 'row g-2 mb-2 align-items-center stop-row';
            div.innerHTML = `
                <div class="col-md-5">
                    <input type="text" name="StopNames"
                           class="form-control form-control-sm"
                           placeholder="Stop name" />
                </div>
                <div class="col-md-2">
                    <input type="number" name="StopOrders"
                           class="form-control form-control-sm"
                           value="${stopCount}" />
                </div>
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <input type="number" name="StopDistances"
                               class="form-control" step="0.1" />
                        <span class="input-group-text">km</span>
                    </div>
                </div>
                <div class="col-md-1">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="this.closest('.stop-row').remove()">
                        <i class="fa fa-times"></i>
                    </button>
                </div>`;
            document.getElementById('stopsContainer').appendChild(div);
        }
    </script>
}